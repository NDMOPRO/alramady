// ============================================================================
// REGISTRY TABLES
// ============================================================================

model Tenant {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(128)
  domain      String?  @db.VarChar(255)
  logoUrl     String?  @map("logo_url") @db.Text
  settings    Json?    @default("{}")
  plan        String   @default("free") @db.VarChar(64)
  isActive    Boolean  @default(true) @map("is_active")
  maxUsers    Int      @default(10) @map("max_users")
  maxStorage  BigInt   @default(1073741824) @map("max_storage")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  users              User[]
  datasets           Dataset[]
  dashboards         Dashboard[]
  reports            Report[]
  templates          Template[]
  folders            Folder[]
  knowledgeBases     KnowledgeBase[]
  prompts            Prompt[]
  glossaries         Glossary[]
  kpis               Kpi[]
  workflowInstances  WorkflowInstance[]
  scheduledReports   ScheduledReport[]
  libraryAssets      LibraryAsset[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  reportDefinitions  ReportDefinition[]
  reportTemplates    ReportTemplate[]    @relation("ReportTemplateTenant")
  reportSchedules    ReportSchedule[]    @relation("ReportScheduleTenant")
  reportDataSources  ReportDataSource[]  @relation("ReportDataSourceTenant")
  compareSchedules   ReportCompareSchedule[] @relation("CompareScheduleTenant")
  themes             Theme[]
  connectorConnections ConnectorConnection[]
  policies           Policy[]
  compliancePolicies CompliancePolicy[]
  workflowDefinitions WorkflowDefinition[]
  layoutAnalyses      LayoutAnalysis[]
  documentExtractions DocumentExtraction[]
  pixelValidations    PixelValidation[]
  fontRecognitions    FontRecognition[]
  layoutTranslations  LayoutTranslation[]
  qualityValidations  QualityValidation[]
  bridgePayloads      BridgePayload[]
  dataLineage         DataLineage[]
  trainingDatasets    TrainingDataset[]
  trainingJobs        TrainingJob[]
  modelRegistry       ModelRegistry[]
  contextMemoryLong   ContextMemoryLong[]
  episodeMemory       EpisodeMemory[]
  semanticFacts       SemanticFact[]

  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
  @@map("tenants")
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  email             String     @db.VarChar(320)
  passwordHash      String?    @map("password_hash") @db.Text
  firstName         String     @map("first_name") @db.VarChar(128)
  lastName          String     @map("last_name") @db.VarChar(128)
  displayName       String?    @map("display_name") @db.VarChar(255)
  avatarUrl         String?    @map("avatar_url") @db.Text
  phone             String?    @db.VarChar(32)
  locale            Language   @default(EN)
  timezone          String     @default("UTC") @db.VarChar(64)
  status            UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz
  preferences       Json?      @default("{}")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles            UserRole[]
  datasets             Dataset[]             @relation("DatasetCreator")
  datasetsUpdated      Dataset[]             @relation("DatasetUpdater")
  ingestionJobs        IngestionJob[]
  dashboards           Dashboard[]           @relation("DashboardCreator")
  reports              Report[]              @relation("ReportCreator")
  presentations        Presentation[]        @relation("PresentationCreator")
  infographics         Infographic[]         @relation("InfographicCreator")
  workbooks            Workbook[]            @relation("WorkbookCreator")
  aiSessions           AiSession[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  workflowStepsAssigned WorkflowStep[]       @relation("StepAssignee")
  workflowStepsCompleted WorkflowStep[]      @relation("StepCompletedBy")
  scheduledReports     ScheduledReport[]
  conversionJobs       ConversionJob[]
  localizationJobs     LocalizationJob[]
  promptVersions       PromptVersion[]
  kpis                 Kpi[]
  reportDefinitions    ReportDefinition[]          @relation("ReportDefinitionCreator")
  reportTemplatesCreated ReportTemplate[]          @relation("ReportTemplateCreator")
  reportSchedulesCreated ReportSchedule[]          @relation("ReportScheduleCreator")
  reportPostEdits      ReportPostEdit[]            @relation("ReportPostEditCreator")
  externalSimulations  ReportExternalSimulation[]  @relation("ExternalSimulationCreator")
  compareSchedules     ReportCompareSchedule[]     @relation("CompareScheduleCreator")
  interactiveReports   InteractiveReport[]         @relation("InteractiveReportCreator")
  interactiveVersions  InteractiveReportVersion[]  @relation("InteractiveVersionChanger")
  reportComments       ReportComment[]             @relation("ReportCommentUser")
  reportAnnotations    ReportAnnotation[]          @relation("ReportAnnotationCreator")
  distributionConfigs  DistributionConfig[]        @relation("DistributionConfigCreator")
  collaborationSessions CollaborationSession[]
  shareLinks           ShareLink[]
  connectorConnections ConnectorConnection[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  displayName String   @map("display_name") @db.VarChar(128)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  userRoles   UserRole[]
  permissions Permission[]

  @@index([name])
  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt DateTime? @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Dataset {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  createdById     String        @map("created_by_id") @db.Uuid
  updatedById     String?       @map("updated_by_id") @db.Uuid
  folderId        String?       @map("folder_id") @db.Uuid
  name            String        @db.VarChar(512)
  slug            String        @db.VarChar(512)
  description     String?       @db.Text
  source          String?       @db.VarChar(512)
  sourceUrl       String?       @map("source_url") @db.Text
  format          String?       @db.VarChar(64)
  fileSize        BigInt?       @map("file_size")
  rowCount        Int?          @map("row_count")
  columnCount     Int?          @map("column_count")
  schema          Json?
  sampleData      Json?         @map("sample_data")
  status          DatasetStatus @default(DRAFT)
  isPublic        Boolean       @default(false) @map("is_public")
  license         String?       @db.VarChar(256)
  frequency       String?       @db.VarChar(64)
  lastSyncedAt    DateTime?     @map("last_synced_at") @db.Timestamptz
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz
  settings        Json?         @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy         User                @relation("DatasetCreator", fields: [createdById], references: [id])
  updatedBy         User?               @relation("DatasetUpdater", fields: [updatedById], references: [id])
  folder            Folder?             @relation(fields: [folderId], references: [id], onDelete: SetNull)
  columns           DatasetColumn[]
  versions          DatasetVersion[]
  metadata          Metadata[]
  tags              Tag[]
  ingestionJobs     IngestionJob[]
  dataQualityChecks DataQualityCheck[]
  dashboardWidgets  DashboardWidget[]
  dataRows          DataRow[]
  kpis              Kpi[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([createdById])
  @@index([folderId])
  @@index([status])
  @@index([isPublic])
  @@index([deletedAt])
  @@index([name])
  @@map("datasets")
}

model DatasetColumn {
  id            String         @id @default(uuid()) @db.Uuid
  datasetId     String         @map("dataset_id") @db.Uuid
  name          String         @db.VarChar(256)
  displayName   String?        @map("display_name") @db.VarChar(256)
  description   String?        @db.Text
  dataType      ColumnDataType @map("data_type")
  ordinalPosition Int          @map("ordinal_position")
  isNullable    Boolean        @default(true) @map("is_nullable")
  isPrimaryKey  Boolean        @default(false) @map("is_primary_key")
  isUnique      Boolean        @default(false) @map("is_unique")
  defaultValue  String?        @map("default_value") @db.Text
  maxLength     Int?           @map("max_length")
  precision     Int?
  scale         Int?
  format        String?        @db.VarChar(128)
  constraints   Json?
  statistics    Json?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, name])
  @@index([datasetId])
  @@index([dataType])
  @@map("dataset_columns")
}

model DatasetVersion {
  id            String   @id @default(uuid()) @db.Uuid
  datasetId     String   @map("dataset_id") @db.Uuid
  versionNumber Int      @map("version_number")
  changeSummary String?  @map("change_summary") @db.Text
  schema        Json?
  rowCount      Int?     @map("row_count")
  fileSize      BigInt?  @map("file_size")
  filePath      String?  @map("file_path") @db.Text
  checksum      String?  @db.VarChar(128)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, versionNumber])
  @@index([datasetId])
  @@map("dataset_versions")
}

model Metadata {
  id         String   @id @default(uuid()) @db.Uuid
  datasetId  String   @map("dataset_id") @db.Uuid
  key        String   @db.VarChar(256)
  value      String   @db.Text
  valueType  String   @default("string") @map("value_type") @db.VarChar(32)
  language   Language @default(EN)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, key, language])
  @@index([datasetId])
  @@index([key])
  @@map("metadata")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  datasetId String   @map("dataset_id") @db.Uuid
  name      String   @db.VarChar(128)
  slug      String   @db.VarChar(128)
  color     String?  @db.VarChar(7)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, slug])
  @@index([datasetId])
  @@index([slug])
  @@index([name])
  @@map("tags")
}

model Template {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(256)
  slug        String   @db.VarChar(256)
  description String?  @db.Text
  category    String?  @db.VarChar(128)
  type        String   @db.VarChar(64)
  content     Json
  thumbnail   String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  version     Int      @default(1)
  settings    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([type])
  @@index([category])
  @@index([isActive])
  @@index([deletedAt])
  @@map("templates")
}

model Version {
  id            String        @id @default(uuid()) @db.Uuid
  resourceType  ResourceType  @map("resource_type")
  resourceId    String        @map("resource_id") @db.Uuid
  versionNumber Int           @map("version_number")
  label         String?       @db.VarChar(128)
  description   String?       @db.Text
  snapshot      Json
  status        VersionStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([resourceType, resourceId, versionNumber])
  @@index([resourceType, resourceId])
  @@index([status])
  @@map("versions")
}

model Feature {
  id          String        @id @default(uuid()) @db.Uuid
  key         String        @unique @db.VarChar(256)
  name        String        @db.VarChar(256)
  description String?       @db.Text
  status      FeatureStatus @default(DISABLED)
  config      Json?         @default("{}")
  rolloutPct  Int           @default(0) @map("rollout_pct")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([key])
  @@index([status])
  @@map("features")
}

// ============================================================================
// ENGINE TABLES
// ============================================================================

model IngestionJob {
  id              String              @id @default(uuid()) @db.Uuid
  datasetId       String              @map("dataset_id") @db.Uuid
  createdById     String              @map("created_by_id") @db.Uuid
  sourceType      IngestionSourceType @map("source_type")
  sourceConfig    Json                @map("source_config")
  status          IngestionJobStatus  @default(PENDING)
  progress        Float               @default(0)
  totalRows       Int?                @map("total_rows")
  processedRows   Int?                @map("processed_rows")
  failedRows      Int?                @map("failed_rows")
  errorMessage    String?             @map("error_message") @db.Text
  errorDetails    Json?               @map("error_details")
  startedAt       DateTime?           @map("started_at") @db.Timestamptz
  completedAt     DateTime?           @map("completed_at") @db.Timestamptz
  durationMs      Int?                @map("duration_ms")
  retryCount      Int                 @default(0) @map("retry_count")
  maxRetries      Int                 @default(3) @map("max_retries")
  settings        Json?               @default("{}")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([datasetId])
  @@index([createdById])
  @@index([status])
  @@index([sourceType])
  @@index([createdAt])
  @@map("ingestion_jobs")
}

model DataQualityCheck {
  id            String                 @id @default(uuid()) @db.Uuid
  datasetId     String                 @map("dataset_id") @db.Uuid
  checkType     DataQualityCheckType   @map("check_type")
  columnName    String?                @map("column_name") @db.VarChar(256)
  ruleName      String                 @map("rule_name") @db.VarChar(256)
  ruleConfig    Json                   @map("rule_config")
  status        DataQualityCheckStatus @default(PENDING)
  score         Float?
  totalRecords  Int?                   @map("total_records")
  passedRecords Int?                   @map("passed_records")
  failedRecords Int?                   @map("failed_records")
  errorMessage  String?                @map("error_message") @db.Text
  details       Json?
  executedAt    DateTime?              @map("executed_at") @db.Timestamptz
  durationMs    Int?                   @map("duration_ms")
