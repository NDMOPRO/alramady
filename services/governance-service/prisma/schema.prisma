generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                  @id @default(uuid()) @db.Uuid
  name                  String                  @db.VarChar(500)
  createdAt             DateTime                @default(now()) @map("created_at")
  settings_json         Json?
  slug                  String?                 @unique @default(uuid()) @db.VarChar(128)
  domain                String?                 @db.VarChar(255)
  logoUrl               String?                 @map("logo_url")
  settings              Json?                   @default("{}")
  isActive              Boolean?                @default(true) @map("is_active")
  maxUsers              Int?                    @default(10) @map("max_users")
  maxStorage            BigInt?                 @default(1073741824) @map("max_storage")
  updatedAt             DateTime?               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?               @map("deleted_at") @db.Timestamptz(6)
  plan                  String?                 @default("free") @db.VarChar(64)
  ai_sessions           ai_sessions[]
  asset_folders         asset_folders[]
  auditLogs             AuditLog[]
  connector_connections connector_connections[]
  conversion_jobs       conversion_jobs[]
  dashboards            Dashboard[]
  data_sources          data_sources[]
  datasets              Dataset[]
  glossaries            glossaries[]
  infographics          infographics[]
  ingestion_jobs        ingestion_jobs[]
  knowledge_bases       knowledge_bases[]
  knowledge_graph_nodes knowledge_graph_nodes[]
  library_assets        library_assets[]
  localization_jobs     localization_jobs[]
  metadata              metadata[]
  notifications         notifications[]
  presentations         presentations[]
  prompt_templates      prompt_templates[]
  replication_jobs      replication_jobs[]
  reports               Report[]
  roles                 Role[]
  templates             templates[]
  translation_memories  translation_memories[]
  upload_sessions       upload_sessions[]
  users                 User[]
  versions              Version[]
  workbooks             workbooks[]
  workflows             workflows[]

  @@map("tenants")
}

model User {
  id                  String              @id @default(uuid()) @db.Uuid
  name                String?             @db.VarChar(500)
  tenantId            String              @map("tenant_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at")
  email               String?             @unique @db.VarChar(500)
  lastLogin           DateTime?           @map("last_login")
  passwordHash        String              @map("password_hash") @db.VarChar(500)
  role                String?             @default("viewer") @db.VarChar(32)
  status              String              @default("active") @db.VarChar(32)
  username            String?             @unique @db.VarChar(128)
  displayName         String?             @map("display_name") @db.VarChar(255)
  display_name_ar     String?             @db.VarChar(255)
  avatarUrl           String?             @map("avatar_url")
  phone               String?             @db.VarChar(32)
  locale              String?             @default("ar") @db.VarChar(10)
  timezone            String?             @default("Asia/Riyadh") @db.VarChar(64)
  isOwner             Boolean?            @default(false) @map("is_owner")
  two_factor_enabled  Boolean?            @default(false)
  two_factor_secret   String?
  lastLoginAt         DateTime?           @map("last_login_at") @db.Timestamptz(6)
  last_login_ip       String?             @db.VarChar(45)
  failed_login_count  Int?                @default(0)
  locked_until        DateTime?           @db.Timestamptz(6)
  password_changed_at DateTime?           @db.Timestamptz(6)
  metadata            Json?               @default("{}")
  updatedAt           DateTime?           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?           @map("deleted_at") @db.Timestamptz(6)
  ai_sessions         ai_sessions[]
  auditLogs           AuditLog[]
  cell_edit_history   cell_edit_history[]
  dashboards          Dashboard[]
  datasets            Dataset[]
  infographics        infographics[]
  library_assets      library_assets[]
  presentations       presentations[]
  reports             Report[]
  sessions            sessions[]
  tags                tags[]
  templates           templates[]
  userRoles           UserRole[]
  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  versions            Version[]
  workbooks           workbooks[]

  @@index([tenantId])
  @@index([status])
  @@index([role])
  @@map("users")
}

model Role {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  name             String       @db.VarChar(200)
  permissions_json Json?
  displayName      String?      @map("display_name") @db.VarChar(255)
  display_name_ar  String?      @db.VarChar(255)
  description      String?
  isSystem         Boolean?     @default(false) @map("is_system")
  priority         Int?         @default(0)
  permissions_data Json?        @default("[]") @map("permissions")
  createdAt        DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissionRels   Permission[]
  tenants          Tenant       @relation(fields: [tenantId], references: [id])
  userRoles        UserRole[]

  @@unique([tenantId, name], map: "roles_tenant_name_key")
  @@index([tenantId])
  @@map("roles")
}

model UserRole {
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  id         String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  granted_by String?   @db.Uuid
  grantedAt  DateTime? @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id           String    @id @default(uuid()) @db.Uuid
  roleId       String?   @map("role_id") @db.Uuid
  resourceType String?   @map("resource_type") @db.VarChar(64)
  resource_id  String?   @db.Uuid
  action       String    @db.VarChar(64)
  domain       String?   @db.VarChar(64)
  resource     String?   @db.VarChar(64)
  code         String?   @db.VarChar(192)
  description  String?
  is_system    Boolean?  @default(true)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  role         Role?     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([resourceType])
  @@map("permissions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  action      String   @db.VarChar(200)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  detailsJson Json?    @map("details_json")
  ipAddress   String?  @map("ip_address") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entityId])
  @@index([entityType])
  @@map("audit_logs")
}

model Dataset {
  id                      String                    @id @default(uuid()) @db.Uuid
  tenantId                String                    @map("tenant_id") @db.Uuid
  name                    String                    @db.VarChar(500)
  description             String?
  source_type             DatasetSourceType
  file_path               String?                   @db.VarChar(1000)
  format                  String?                   @db.VarChar(50)
  size_bytes              BigInt?
  rowCount                BigInt?                   @map("row_count")
  columnCount             Int?                      @map("column_count")
  schema_json             Json?
  status                  DatasetStatus             @default(active)
  engine                  String?                   @db.VarChar(100)
  created_by              String                    @db.Uuid
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  table_name              String?                   @db.VarChar(500)
  metadata                Json?
  source_connection       String?
  quality_score           Float?
  quality_details         Json?
  tags                    Json?
  category                String?                   @db.VarChar(200)
  owner                   String?                   @db.VarChar(500)
  user_id                 String?                   @db.Uuid
  anomaly_detections      anomaly_detections[]
  column_lineages         column_lineages[]
  dashboard_widgets       dashboard_widgets[]
  data_dictionary_entries data_dictionary_entries[]
  data_profiles           data_profiles?
  data_quality_checks     data_quality_checks[]
  data_rows               data_rows[]
  dataset_access_logs     dataset_access_logs[]
  columns                 DatasetColumn[]
  dataset_usage_stats     dataset_usage_stats?
  versions                DatasetVersion[]
  users                   User                      @relation(fields: [created_by], references: [id])
  tenant                  Tenant                    @relation(fields: [tenantId], references: [id])
  ingestion_jobs          ingestion_jobs[]
  lineage_edges           lineage_edges[]
  lineage_nodes           lineage_nodes[]
  mixed_file_entries      mixed_file_entries[]
  pipelines               pipelines[]
  quality_scores          quality_scores[]
  reading_sessions        reading_sessions[]
  table_views             table_views[]
  visual_processings      visual_processings[]
  workbooks               workbooks[]

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([engine])
  @@index([format])
  @@index([source_type])
  @@map("datasets")
}

model DatasetVersion {
  id            String      @id @default(uuid()) @db.Uuid
  datasetId     String      @map("dataset_id") @db.Uuid
  version       Int
  change_type   ChangeType?
  changeSummary String?     @map("change_summary")
  snapshot_path String?     @db.VarChar(1000)
  createdAt     DateTime    @default(now()) @map("created_at")
  dataset       Dataset     @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@map("dataset_versions")
}

model DatasetColumn {
  id              String   @id @default(uuid()) @db.Uuid
  datasetId       String   @map("dataset_id") @db.Uuid
  name            String   @db.VarChar(500)
  original_name   String?  @db.VarChar(500)
  dataType        String?  @map("data_type") @db.VarChar(100)
  inferred_type   String?  @db.VarChar(100)
  position        Int?
  display_order   Int?     @default(0)
  nullable        Boolean?
  is_visible      Boolean  @default(true)
  is_required     Boolean  @default(false)
  isPrimaryKey    Boolean  @default(false) @map("is_primary_key")
  default_value   String?  @db.VarChar(1000)
  format          String?  @db.VarChar(200)
  min_value       String?  @db.VarChar(500)
  max_value       String?  @db.VarChar(500)
  transformations Json?
  stats_json      Json?
  metadata        Json?
  dataset         Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([display_order])
  @@map("dataset_columns")
}

model Dashboard {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  name              String              @db.VarChar(500)
  layout_json       Json?
  filters_json      Json?
  is_published      Boolean             @default(false)
  created_by        String              @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at")
  slug              String?             @db.VarChar(512)
  description       String?
  visibility        String?             @default("PRIVATE") @db.VarChar(32)
  status            String?             @default("draft") @db.VarChar(32)
  layout            Json?
  theme             Json?
  filters           Json?
  refresh_rate      Int?
  thumbnail         String?
  is_favorite       Boolean?            @default(false)
  view_count        Int?                @default(0)
  settings          Json?               @default("{}")
  published_at      DateTime?           @db.Timestamptz(6)
  updatedAt         DateTime?           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamptz(6)
  folder_id         String?             @db.Uuid
  createdById       String?             @map("created_by_id") @db.Uuid
  title             String?             @db.VarChar(500)
  widgets           Json?
  language          String?             @db.VarChar(20)
  metadata          Json?
  dashboard_filters dashboard_filters[]
  dashboard_widgets dashboard_widgets[]
  users             User                @relation(fields: [created_by], references: [id])
  tenant            Tenant              @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([is_published])
  @@map("dashboards")
}

model Report {
  id                   String                 @id @default(uuid()) @db.Uuid
  tenantId             String                 @map("tenant_id") @db.Uuid
  name                 String                 @db.VarChar(500)
  template_id          String?                @db.Uuid
  config_json          Json?
  schedule_json        Json?
  data_source_id       String?                @db.Uuid
  last_generated       DateTime?
  created_by           String                 @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at")
  description          String?
  type                 String?                @default("general") @db.VarChar(200)
  format               String?                @db.VarChar(50)
  status               String?                @default("PENDING") @db.VarChar(50)
  data_sources         Json?
  parameters           Json?
  content              Json?
  metadata             Json?
  generated_at         DateTime?              @db.Timestamp(6)
  header_config        Json?
  footer_config        Json?
  updatedAt            DateTime?              @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  distribution_configs distribution_configs[]
  report_annotations   report_annotations[]
  report_charts        report_charts[]
  report_comments      report_comments[]
  report_outputs       report_outputs[]
  report_schedules     report_schedules[]
  report_sections      report_sections[]
  users                User                   @relation(fields: [created_by], references: [id])
  templates            templates?             @relation(fields: [template_id], references: [id])
  tenant               Tenant                 @relation(fields: [tenantId], references: [id])
  scheduled_reports    scheduled_reports[]

  @@index([tenantId])
  @@map("reports")
}

model Kpi {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String      @map("tenant_id") @db.Uuid
  name             String      @db.VarChar(500)
  description      String?
  datasetId        String?     @map("dataset_id") @db.Uuid
  query            String?
  status           kpi_status? @default(ACTIVE)
  settings         Json?
  target           Float?
  unit             String?     @db.VarChar(100)
  category         String?     @db.VarChar(200)
  format           String?     @db.VarChar(100)
  threshold        Json?
  trend_direction  String?     @db.VarChar(50)
  calculation_type String?     @db.VarChar(100)
  aggregation      String?     @db.VarChar(100)
  group_by         String?     @db.VarChar(500)
  filters          Json?
  display_config   Json?
  alert_config     Json?
  metadata         Json?
  lastCalculatedAt DateTime?   @map("last_calculated_at") @db.Timestamp(6)
  createdAt        DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime?   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  kpi_values       KpiValue[]

  @@map("kpis")
}

model Version {
  id            String     @id @default(uuid()) @db.Uuid
  entity_type   EntityType
  entity_id     String     @db.Uuid
  tenant_id     String     @db.Uuid
  versionNumber Int        @map("version_number")
  snapshot_json Json?
  change_log    String?
  created_by    String     @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")
  users         User       @relation(fields: [created_by], references: [id])
  tenants       Tenant     @relation(fields: [tenant_id], references: [id])

  @@index([entity_id])
  @@index([entity_type])
  @@index([tenant_id])
  @@map("versions")
}

model Policy {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(255)
  description String    @default("")
  resource    String    @db.VarChar(100)
  action      String    @db.VarChar(100)
  conditions  Json      @default("{}")
  effect      String    @default("allow") @db.VarChar(30)
  priority    Int?      @default(0)
  enabled     Boolean?  @default(true)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("policies")
}

model WorkflowDefinition {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  name            String    @db.VarChar(255)
  description     String?
  triggerResource String    @map("trigger_resource") @db.VarChar(100)
  triggerAction   String    @map("trigger_action") @db.VarChar(100)
  steps           Json      @default("[]")
  status          String?   @default("active") @db.VarChar(30)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("workflow_definitions")
}

model AccessPolicy {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @db.VarChar(255)
  description  String?
  resourceType String    @map("resource_type") @db.VarChar(64)
  resourceId   String?   @map("resource_id") @db.VarChar(128)
  rules        String?
  priority     Int?      @default(0)
  enabled      Boolean?  @default(true)
  createdBy    String?   @map("created_by") @db.VarChar(128)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("access_policies")
}

model RlsPolicy {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.VarChar(128)
  resourceType String    @map("resource_type") @db.VarChar(64)
  name         String    @db.VarChar(255)
  description  String?
  config       Json?
  priority     Int?      @default(0)
  active       Boolean?  @default(true)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("rls_policies")
}

model Comparison {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(255)
  description String?
  config      Json?
  status      String?   @db.VarChar(32)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("comparisons")
}

model EngineIntegration {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(255)
  description String?
  config      Json?
  status      String?   @db.VarChar(32)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("engine_integrations")
}

model OneClickOp {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(255)
  description String?
  config      Json?
  status      String?   @db.VarChar(32)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("one_click_ops")
}

model ProductLevel {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(255)
  description String?
  config      Json?
  status      String?   @db.VarChar(32)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("product_levels")
}

model Team {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String       @db.VarChar(255)
  description    String?
  organizationId String?      @map("organization_id") @db.VarChar(128)
  config         Json?
  status         String?      @db.VarChar(32)
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  members        TeamMember[]

  @@map("teams")
}

model TeamMember {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String    @map("team_id") @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  role      String?   @db.VarChar(64)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("team_members")
}

model ArchiveConfig {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType      String    @map("entity_type") @db.VarChar(64)
  retentionDays   Int       @default(365) @map("retention_days")
  archiveStrategy String    @default("soft_delete") @map("archive_strategy") @db.VarChar(32)
  isEnabled       Boolean?  @default(true) @map("is_enabled")
  filters         String?
  configuredBy    String?   @map("configured_by") @db.VarChar(128)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("archive_configs")
}

model ArchiveCycleLog {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  processedConfigs Int       @default(0) @map("processed_configs")
  totalArchived    Int       @default(0) @map("total_archived")
  errors           String?
  executedAt       DateTime? @default(now()) @map("executed_at") @db.Timestamptz(6)

  @@map("archive_cycle_logs")
}

model ArchivableEntity {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType   String    @map("entity_type") @db.VarChar(64)
  isArchived   Boolean?  @default(false) @map("is_archived")
  isCompressed Boolean?  @default(false) @map("is_compressed")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("archivable_entities")
}

model ArchiveEntry {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType      String    @map("entity_type") @db.VarChar(64)
  entityId        String    @map("entity_id") @db.VarChar(128)
  originalData    String?   @map("original_data")
  archiveStrategy String?   @map("archive_strategy") @db.VarChar(32)
