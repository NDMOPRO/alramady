}

model ModelRegistry {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  jobId           String   @unique @map("job_id") @db.Uuid
  name            String   @db.VarChar(255)
  version         String   @db.VarChar(50)
  taskType        String   @map("task_type") @db.VarChar(50)
  baseModel       String   @map("base_model") @db.VarChar(100)
  metrics         Json     @db.JsonB
  status          String   @default("registered") @db.VarChar(30)
  deploymentId    String?  @map("deployment_id") @db.VarChar(255)
  artifactPath    String   @map("artifact_path") @db.VarChar(500)
  metadata        Json?    @db.JsonB
  promotedAt      DateTime? @map("promoted_at") @db.Timestamptz
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  job      TrainingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, taskType])
  @@index([status])
  @@map("model_registry")
}

// ============================================================================
// CONTEXT MEMORY LAYER
// ============================================================================

model ContextMemoryLong {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  category        String   @db.VarChar(100)
  key             String   @db.VarChar(255)
  value           Json     @db.JsonB
  accessCount     Int      @default(0) @map("access_count")
  lastAccessedAt  DateTime @default(now()) @map("last_accessed_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, category, key])
  @@index([tenantId, userId])
  @@index([category])
  @@map("context_memory_long")
}

model EpisodeMemory {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  requestText     String   @map("request_text") @db.Text
  intent          String   @db.VarChar(100)
  actions         Json     @db.JsonB
  outcome         String   @db.VarChar(50)
  satisfaction    Float?
  duration        Int?
  context         Json?    @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, createdAt])
  @@index([intent])
  @@map("episode_memory")
}

model SemanticFact {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  subject         String   @db.VarChar(255)
  predicate       String   @db.VarChar(255)
  object          String   @db.Text
  confidence      Float    @default(1.0)
  source          String   @db.VarChar(100)
  validatedAt     DateTime? @map("validated_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, subject])
  @@index([predicate])
  @@map("semantic_facts")
}
