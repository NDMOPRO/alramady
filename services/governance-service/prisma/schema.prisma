generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                  @id @default(uuid()) @db.Uuid
  name                  String                  @db.VarChar(255)
  slug                  String                  @unique @default(uuid()) @db.VarChar(128)
  domain                String?                 @db.VarChar(255)
  logoUrl               String?                 @map("logo_url")
  settings              Json?                   @default("{}")
  plan                  String                  @default("free") @db.VarChar(64)
  isActive              Boolean                 @default(true) @map("is_active")
  maxUsers              Int                     @default(10) @map("max_users")
  maxStorage            BigInt                  @default(1073741824) @map("max_storage")
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?               @map("deleted_at") @db.Timestamptz(6)
  asset_folders         asset_folders[]
  auditLogs             AuditLog[]
  connector_connections connector_connections[]
  conversion_jobs       conversion_jobs[]
  dashboards            Dashboard[]
  data_sources          data_sources[]
  datasets              Dataset[]
  excel_workbooks       excel_workbooks[]
  glossaries            glossaries[]
  infographics          infographics[]
  ingestion_jobs        ingestion_jobs[]
  knowledge_graph_nodes knowledge_graph_nodes[]
  kpis                  Kpi[]
  library_assets        library_assets[]
  localization_jobs     localization_jobs[]
  metadata              metadata[]
  notifications         notifications[]
  policies              Policy[]
  presentations         presentations[]
  prompt_templates      prompt_templates[]
  replication_jobs      replication_jobs[]
  reports               Report[]
  roles                 Role[]
  themes                themes[]
  translation_memories  translation_memories[]
  upload_sessions       upload_sessions[]
  users                 User[]
  workbooks             workbooks[]
  workflow_definitions  WorkflowDefinition[]
  workflows             workflows[]

  @@index([deletedAt])
  @@index([isActive])
  @@index([slug])
  @@map("tenants")
}

model User {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  email             String              @unique @db.VarChar(320)
  name              String?             @db.VarChar(255)
  passwordHash      String?             @map("password_hash")
  first_name        String              @default("") @db.VarChar(128)
  last_name         String              @default("") @db.VarChar(128)
  displayName       String?             @map("display_name") @db.VarChar(255)
  avatarUrl         String?             @map("avatar_url")
  phone             String?             @db.VarChar(32)
  role              String?             @db.VarChar(64)
  locale            Language            @default(EN)
  timezone          String              @default("UTC") @db.VarChar(64)
  status            UserStatus          @default(PENDING_VERIFICATION)
  email_verified_at DateTime?           @db.Timestamptz(6)
  lastLoginAt       DateTime?           @map("last_login_at") @db.Timestamptz(6)
  lastLogin         DateTime?           @map("last_login") @db.Timestamptz(6)
  mfa_secret        String?
  mfa_enabled       Boolean             @default(false)
  preferences       Json?               @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamptz(6)
  isOwner           Boolean?            @default(false) @map("is_owner")
  username          String?             @db.VarChar(128)
  auditLogs         AuditLog[]
  cell_edit_history cell_edit_history[]
  dashboards        Dashboard[]
  infographics      infographics[]
  library_assets    library_assets[]
  presentations     presentations[]
  tags              tags[]
  team_members      TeamMember[]
  userRoles         UserRole[]
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workbooks         workbooks[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([status])
  @@index([role])
  @@index([deletedAt])
  @@index([email])
  @@map("users")
}

model Role {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String?      @map("tenant_id") @db.Uuid
  name           String       @unique @db.VarChar(128)
  displayName    String       @default("") @map("display_name") @db.VarChar(128)
  description    String?
  isSystem       Boolean      @default(false) @map("is_system")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissionRels Permission[]
  tenants        Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles      UserRole[]

  @@index([tenantId])
  @@index([name])
  @@map("roles")
}

model UserRole {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  tenant_id  String?   @db.Uuid
  grantedAt  DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @db.Timestamptz(6)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([tenant_id])
  @@map("user_roles")
}

model Permission {
  id            String    @id @default(uuid()) @db.Uuid
  roleId        String    @map("role_id") @db.Uuid
  user_id       String?   @db.Uuid
  tenant_id     String?   @db.Uuid
  name          String?   @db.VarChar(255)
  resource      String?   @db.VarChar(128)
  resourceType  String    @default("") @map("resource_type") @db.VarChar(128)
  action        String    @default("") @db.VarChar(128)
  conditions    Json?
  is_granted    Boolean   @default(true)
  granted_by    String?   @db.VarChar(128)
  source        String?   @db.VarChar(128)
  suggestion_id String?   @db.Uuid
  revoked_by    String?   @db.VarChar(128)
  revoke_reason String?
  deleted_at    DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at    DateTime  @db.Timestamptz(6)
  role          Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([resourceType])
  @@index([action])
  @@index([tenant_id])
  @@index([user_id])
  @@map("permissions")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  action        String   @db.VarChar(128)
  resource_type String   @default("") @db.VarChar(64)
  resource_id   String   @default("") @db.VarChar(128)
  resource_name String?  @db.VarChar(512)
  entityType    String?  @map("entity_type") @db.VarChar(128)
  entityId      String?  @map("entity_id") @db.VarChar(128)
  old_value     Json?
  new_value     Json?
  detailsJson   Json?    @map("details_json")
  details       Json?
  changes       Json?
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  user_agent    String?
  session_id    String?  @db.VarChar(128)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entityId])
  @@index([entityType])
  @@index([entityType, entityId])
  @@index([resource_type, resource_id])
  @@map("audit_logs")
}

model Dataset {
  id                      String                    @id @default(uuid()) @db.Uuid
  tenantId                String                    @map("tenant_id") @db.Uuid
  created_by_id           String                    @db.Uuid
  name                    String                    @db.VarChar(512)
  slug                    String                    @db.VarChar(512)
  description             String?
  status                  DatasetStatus             @default(DRAFT)
  classification          String?                   @db.VarChar(64)
  rowCount                Int?                      @map("row_count")
  columnCount             Int?                      @map("column_count")
  schema                  Json?
  is_public               Boolean                   @default(false)
  settings                Json?                     @default("{}")
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deleted_at              DateTime?                 @db.Timestamptz(6)
  file_path               String?                   @db.VarChar(1000)
  format                  String?                   @db.VarChar(50)
  size_bytes              BigInt?
  engine                  String?                   @db.VarChar(100)
  created_by              String?                   @db.Uuid
  table_name              String?                   @db.VarChar(500)
  metadata                Json?
  source_connection       String?
  quality_score           Float?
  quality_details         Json?
  tags                    Json?
  category                String?                   @db.VarChar(200)
  owner                   String?                   @db.VarChar(500)
  schema_json             Json?
  source_type             DatasetSourceType?        @default(file)
  anomaly_detections      anomaly_detections[]
  column_lineages         column_lineages[]
  dashboard_widgets       dashboard_widgets[]
  data_dictionary_entries data_dictionary_entries[]
  data_profiles           data_profiles?
  data_quality_checks     data_quality_checks[]
  data_rows               data_rows[]
  dataset_access_logs     dataset_access_logs[]
  columns                 DatasetColumn[]
  dataset_rows            dataset_rows[]
  dataset_usage_stats     dataset_usage_stats?
  versions                DatasetVersion[]
  tenant                  Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingestion_jobs          ingestion_jobs[]
  kpis                    Kpi[]
  lineage_edges           lineage_edges[]
  lineage_nodes           lineage_nodes[]
  mixed_file_entries      mixed_file_entries[]
  pipelines               pipelines[]
  quality_scores          quality_scores[]
  reading_sessions        reading_sessions[]
  table_views             table_views[]
  visual_processings      visual_processings[]
  workbooks               workbooks[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([created_by_id])
  @@index([deleted_at])
  @@map("datasets")
}

model DatasetVersion {
  id                  String   @id @default(uuid()) @db.Uuid
  datasetId           String   @map("dataset_id") @db.Uuid
  version_number      Int      @default(0)
  version             Int      @default(0)
  changeSummary       String?  @map("change_summary")
  schema              Json?
  row_count           Int?
  file_size           BigInt?
  file_path           String?
  checksum            String?  @db.VarChar(128)
  masked_columns      Json?
  masking_rules       Json?
  anonymized_columns  Json?
  anonymization_rules Json?
  data_json           Json?
  change_description  String?
  changed_by          String?  @db.VarChar(128)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at          DateTime @db.Timestamptz(6)
  dataset             Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, version_number])
  @@index([datasetId])
  @@index([version])
  @@index([datasetId], map: "idx_dataset_versions_dataset_id")
  @@map("dataset_versions")
}

model DatasetColumn {
  id               String   @id @default(uuid()) @db.Uuid
  datasetId        String   @map("dataset_id") @db.Uuid
  name             String   @db.VarChar(256)
  display_name     String?  @db.VarChar(256)
  description      String?
  dataType         String   @map("data_type") @db.VarChar(32)
  ordinal_position Int
  is_nullable      Boolean  @default(true)
  isPrimaryKey     Boolean  @default(false) @map("is_primary_key")
  encrypted        Boolean  @default(false)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @db.Timestamptz(6)
  dataset          Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, name])
  @@index([datasetId])
  @@index([datasetId], map: "idx_dataset_columns_dataset_id")
  @@map("dataset_columns")
}

model Dashboard {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  createdById       String              @map("created_by_id") @db.Uuid
  name              String              @db.VarChar(512)
  slug              String              @db.VarChar(512)
  description       String?
  visibility        DashboardVisibility @default(PRIVATE)
  kpi_ids           String[]
  settings          Json?               @default("{}")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamptz(6)
  folder_id         String?
  layout            Json?
  theme             Json?
  filters           Json?
  refresh_rate      Int?
  thumbnail         String?
  is_favorite       Boolean?            @default(false)
  view_count        Int?                @default(0)
  published_at      DateTime?           @db.Timestamptz(6)
  status            String?             @default("active") @db.VarChar(50)
  config            Json?               @default("{}")
  user_id           String?
  version           Int?                @default(1)
  dashboard_filters dashboard_filters[]
  dashboard_widgets dashboard_widgets[]
  users             User                @relation(fields: [createdById], references: [id])
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([createdById])
  @@index([deletedAt])
  @@index([visibility])
  @@index([createdById], map: "idx_dashboards_created_by_id")
  @@index([deletedAt], map: "idx_dashboards_deleted_at")
  @@index([folder_id], map: "idx_dashboards_folder_id")
  @@index([tenantId], map: "idx_dashboards_tenant_id")
  @@index([visibility], map: "idx_dashboards_visibility")
  @@map("dashboards")
}

model Report {
  id                   String                 @id @default(uuid()) @db.Uuid
  tenantId             String                 @map("tenant_id") @db.Uuid
  created_by_id        String                 @db.Uuid
  name                 String                 @db.VarChar(512)
  slug                 String                 @db.VarChar(512)
  description          String?
  status               ReportStatus           @default(DRAFT)
  kpi_ids              String[]
  language             Language               @default(EN)
  settings             Json?                  @default("{}")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deleted_at           DateTime?              @db.Timestamptz(6)
  distribution_configs distribution_configs[]
  report_annotations   report_annotations[]
  report_charts        report_charts[]
  report_comments      report_comments[]
  report_outputs       report_outputs[]
  report_schedules     report_schedules[]
  report_sections      report_sections[]
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scheduled_reports    scheduled_reports[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([created_by_id])
  @@index([deleted_at])
  @@index([status])
  @@map("reports")
}

model Kpi {
  id                String            @id @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  created_by_id     String            @db.Uuid
  datasetId         String?           @map("dataset_id") @db.Uuid
  name              String            @db.VarChar(256)
  slug              String            @db.VarChar(256)
  description       String?
  status            KpiStatus         @default(ACTIVE)
  unit              String?           @db.VarChar(64)
  formula           String?
  query             String?
  current_value     Float?
  previous_value    Float?
  target_value      Float?
  min_value         Float?
  max_value         Float?
  trend             KpiTrend          @default(UNKNOWN)
  change_percent    Float?
  sensitivity_level String?           @db.VarChar(32)
  frequency         ScheduleFrequency @default(DAILY)
  lastCalculatedAt  DateTime?         @map("last_calculated_at") @db.Timestamptz(6)
  settings          Json?             @default("{}")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deleted_at        DateTime?         @db.Timestamptz(6)
  datasets          Dataset?          @relation(fields: [datasetId], references: [id])
  tenants           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([created_by_id])
  @@index([datasetId])
  @@index([deleted_at])
  @@index([status])
  @@index([tenantId])
  @@map("kpis")
}

model Version {
  id            String        @id @default(uuid()) @db.Uuid
  resource_type String        @db.VarChar(64)
  resource_id   String        @db.Uuid
  versionNumber Int           @map("version_number")
  label         String?       @db.VarChar(128)
  description   String?
  snapshot      Json
  status        VersionStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updated_at    DateTime      @db.Timestamptz(6)

  @@unique([resource_type, resource_id, versionNumber])
  @@index([resource_type, resource_id])
  @@index([status])
  @@map("versions")
}

model Policy {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  conditions  Json
  effect      String   @db.VarChar(30)
  priority    Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenants     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@index([tenantId, resource, action])
  @@map("policies")
}

model WorkflowDefinition {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String   @db.VarChar(255)
  description     String?
  triggerResource String   @map("trigger_resource") @db.VarChar(100)
  triggerAction   String   @map("trigger_action") @db.VarChar(100)
  steps           Json
  status          String   @default("active") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenants         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([tenantId, triggerResource])
  @@map("workflow_definitions")
}

model AccessPolicy {
  id           String   @id @db.Uuid
  name         String   @db.VarChar(255)
  description  String?
  resourceType String   @map("resource_type") @db.VarChar(64)
  resourceId   String?  @map("resource_id") @db.VarChar(128)
  rules        String?
  priority     Int      @default(0)
  enabled      Boolean  @default(true)
  createdBy    String?  @map("created_by") @db.VarChar(128)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([enabled])
  @@index([resourceType, resourceId])
  @@map("access_policies")
}

model RlsPolicy {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.VarChar(128)
  resourceType String    @map("resource_type") @db.VarChar(64)
  name         String    @db.VarChar(255)
  description  String?
  config       Json?
  priority     Int       @default(0)
  active       Boolean   @default(true)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([active])
  @@index([tenantId, resourceType])
  @@map("rls_policies")
}

model Comparison {
  id          String   @id @db.Uuid
  name        String   @db.VarChar(255)
  description String?
  config      Json?
  status      String?  @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("comparisons")
}

model EngineIntegration {
  id          String   @id @db.Uuid
  name        String   @db.VarChar(255)
  description String?
  config      Json?
  status      String?  @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("engine_integrations")
}

model OneClickOp {
  id          String   @id @db.Uuid
  name        String   @db.VarChar(255)
  description String?
  config      Json?
  status      String?  @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("one_click_ops")
}

model ProductLevel {
  id          String   @id @db.Uuid
  name        String   @db.VarChar(255)
  description String?
  config      Json?
  status      String?  @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("product_levels")
}

model Team {
  id             String       @id @db.Uuid
  name           String       @db.VarChar(255)
  description    String?
  organizationId String?      @map("organization_id") @db.VarChar(128)
  config         Json?
  status         String?      @db.VarChar(32)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  members        TeamMember[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  users     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model ArchiveConfig {
  id              String   @id @db.Uuid
  entityType      String   @map("entity_type") @db.VarChar(64)
  retentionDays   Int      @map("retention_days")
  archiveStrategy String   @map("archive_strategy") @db.VarChar(32)
