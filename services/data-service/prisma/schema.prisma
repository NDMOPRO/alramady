model ConnectorConnection {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  userId         String    @map("user_id") @db.VarChar(500)
  connectorType  String    @map("connector_type") @db.VarChar(100)
  accessToken    String    @map("access_token") @db.Text
  refreshToken   String?   @map("refresh_token") @db.Text
  expiresAt      DateTime  @map("expires_at")
  tokenType      String    @default("Bearer") @map("token_type") @db.VarChar(50)
  status         String    @default("active") @db.VarChar(50)
  revokedAt      DateTime? @map("revoked_at")
  lastUsedAt     DateTime? @map("last_used_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([connectorType])
  @@index([status])
  @@map("connector_connections")
}

// ─── Data Engine: Data Source ───────────────────────────────────

model DataSource {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  name           String    @db.VarChar(500)
  type           String    @db.VarChar(100)
  columns        String?   @db.Text
  externalId     String?   @map("external_id") @db.VarChar(500)
  recordCount    Int?      @map("record_count")
  lastSyncAt     DateTime? @map("last_sync_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  syncSchedules  SyncSchedule[]
  syncLogs       SyncLog[]

  @@index([tenantId])
  @@index([type])
  @@map("data_sources")
}

// ─── Data Engine: Knowledge Graph ──────────────────────────────

model KnowledgeGraphNode {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  entityId       String    @map("entity_id") @db.VarChar(500)
  entityType     String    @map("entity_type") @db.VarChar(100)
  label          String    @db.VarChar(500)
  metadata       String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([entityId])
  @@index([entityType])
  @@map("knowledge_graph_nodes")
}

model KnowledgeGraphEdge {
  id             String    @id @default(uuid()) @db.Uuid
  fromEntityId   String    @map("from_entity_id") @db.VarChar(500)
  toEntityId     String    @map("to_entity_id") @db.VarChar(500)
  relationship   String    @db.VarChar(200)
  weight         Float     @default(1.0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([relationship])
  @@map("knowledge_graph_edges")
}

// ─── Data Engine: Sync Schedule & Log ──────────────────────────

model SyncSchedule {
  id             String    @id @default(uuid()) @db.Uuid
  sourceId       String    @unique @map("source_id") @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  frequency      String    @db.VarChar(50)
  isActive       Boolean   @default(true) @map("is_active")
  lastRunAt      DateTime? @map("last_run_at")
  nextRunAt      DateTime  @map("next_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  source         DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive])
  @@map("sync_schedules")
}

model SyncLog {
  id               String    @id @default(uuid()) @db.Uuid
  sourceId         String    @map("source_id") @db.Uuid
  status           String    @db.VarChar(50)
  recordsImported  Int       @default(0) @map("records_imported")
  duration         Int       @default(0)
  error            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")

  source           DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([createdAt])
  @@map("sync_logs")
}

// ─── Data Engine: Upload Session ───────────────────────────────

model UploadSession {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  fileName       String    @map("file_name") @db.VarChar(500)
  fileSize       Int       @map("file_size")
  mimeType       String    @map("mime_type") @db.VarChar(200)
  chunkSize      Int       @map("chunk_size")
  totalChunks    Int       @map("total_chunks")
  uploadedChunks String    @default("[]") @map("uploaded_chunks") @db.Text
  status         String    @default("active") @db.VarChar(50)
  filePath       String?   @map("file_path") @db.VarChar(1000)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("upload_sessions")
}

