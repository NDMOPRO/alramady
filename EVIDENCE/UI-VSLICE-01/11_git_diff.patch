+}
+
+export async function rasedPreferenceSet(values: Record<string, unknown>, scope: "user" | "workspace" = "workspace") {
+  return callRasedTool<{ preferences: Record<string, unknown> }>("rased.preference.set", {
+    context: { mode: "AUTO" },
