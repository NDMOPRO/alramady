// ============================================================================
// Governance Service - Prisma Schema
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
  DATA_STEWARD
  ANALYST
  API_CONSUMER
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  EXPORT
  IMPORT
  SHARE
  PUBLISH
  MANAGE
  EXECUTE
}

enum ResourceType {
  DATASET
  DASHBOARD
  REPORT
  PRESENTATION
  INFOGRAPHIC
  WORKBOOK
  TEMPLATE
  FOLDER
  KNOWLEDGE_BASE
  KPI
  LIBRARY_ASSET
}

enum DatasetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  UNDER_REVIEW
  REJECTED
}

enum KpiStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
}

enum KpiTrend {
  UP
  DOWN
  STABLE
  UNKNOWN
}

enum ScheduleFrequency {
  ONCE
  HOURLY
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CRON
}

enum DashboardVisibility {
  PRIVATE
  TEAM
  ORGANIZATION
  PUBLIC
}

enum ReportStatus {
  DRAFT
  GENERATING
  COMPLETED
  FAILED
  SCHEDULED
}

enum Language {
  AR
  EN
  FR
  ES
  DE
  ZH
  JA
  KO
  RU
  PT
  IT
  NL
  TR
  HI
  UR
}

enum VersionStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  ARCHIVED
}

// ============================================================================
// CORE MODELS
// ============================================================================

model Tenant {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(255)
  slug        String    @unique @default(uuid()) @db.VarChar(128)
  domain      String?   @db.VarChar(255)
  logoUrl     String?   @map("logo_url") @db.Text
  settings    Json?     @default("{}")
  plan        String    @default("free") @db.VarChar(64)
  isActive    Boolean   @default(true) @map("is_active")
  maxUsers    Int       @default(10) @map("max_users")
  maxStorage  BigInt    @default(1073741824) @map("max_storage")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  users              User[]
  datasets           Dataset[]
  dashboards         Dashboard[]
  reports            Report[]
  auditLogs          AuditLog[]
  kpis               Kpi[]
  policies           Policy[]
  workflowDefinitions WorkflowDefinition[]

  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
  @@map("tenants")
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  email             String     @unique @db.VarChar(320)
  name              String?    @db.VarChar(255)
  passwordHash      String?    @map("password_hash") @db.Text
  firstName         String     @default("") @map("first_name") @db.VarChar(128)
  lastName          String     @default("") @map("last_name") @db.VarChar(128)
  displayName       String?    @map("display_name") @db.VarChar(255)
  avatarUrl         String?    @map("avatar_url") @db.Text
  phone             String?    @db.VarChar(32)
  role              String?    @db.VarChar(64)
  locale            Language   @default(EN)
  timezone          String     @default("UTC") @db.VarChar(64)
  status            UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz
  lastLogin         DateTime?  @map("last_login") @db.Timestamptz
  mfaSecret         String?    @map("mfa_secret") @db.Text
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  preferences       Json?      @default("{}")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  auditLogs   AuditLog[]
  teamMembers TeamMember[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  name        String   @unique @db.VarChar(128)
  displayName String   @default("") @map("display_name") @db.VarChar(128)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  userRoles   UserRole[]
  permissions Permission[]

  @@index([name])
  @@map("roles")
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz
  expiresAt DateTime? @map("expires_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([tenantId])
  @@map("user_roles")
}

model Permission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  name         String?  @db.VarChar(255)
  resource     String?  @db.VarChar(128)
  resourceType String   @default("") @map("resource_type") @db.VarChar(128)
  action       String   @default("") @db.VarChar(128)
  conditions   Json?
  isGranted    Boolean  @default(true) @map("is_granted")
  grantedBy    String?  @map("granted_by") @db.VarChar(128)
  source       String?  @db.VarChar(128)
  suggestionId String?  @map("suggestion_id") @db.Uuid
  revokedBy    String?  @map("revoked_by") @db.VarChar(128)
  revokeReason String?  @map("revoke_reason") @db.Text
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([userId])
  @@index([tenantId])
  @@index([resourceType])
  @@index([action])
  @@map("permissions")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String   @db.VarChar(128)
  resourceType String   @default("") @map("resource_type") @db.VarChar(64)
  resourceId   String   @default("") @map("resource_id") @db.VarChar(128)
  resourceName String?  @map("resource_name") @db.VarChar(512)
  entityType   String?  @map("entity_type") @db.VarChar(128)
  entityId     String?  @map("entity_id") @db.VarChar(128)
  oldValue     Json?    @map("old_value")
  newValue     Json?    @map("new_value")
  detailsJson  Json?    @map("details_json")
  details      Json?
  changes      Json?
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  sessionId    String?  @map("session_id") @db.VarChar(128)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// DATA MODELS
// ============================================================================

model Dataset {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  createdById     String        @map("created_by_id") @db.Uuid
  name            String        @db.VarChar(512)
  slug            String        @db.VarChar(512)
  description     String?       @db.Text
  status          DatasetStatus @default(DRAFT)
  classification  String?       @db.VarChar(64)
  rowCount        Int?          @map("row_count")
  columnCount     Int?          @map("column_count")
  schema          Json?
  isPublic        Boolean       @default(false) @map("is_public")
  settings        Json?         @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions DatasetVersion[]
  columns  DatasetColumn[]
  kpis     Kpi[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([createdById])
  @@index([status])
  @@index([deletedAt])
  @@map("datasets")
}

model DatasetVersion {
  id            String   @id @default(uuid()) @db.Uuid
  datasetId     String   @map("dataset_id") @db.Uuid
  versionNumber Int      @default(0) @map("version_number")
  version       Int      @default(0)
  changeSummary String?  @map("change_summary") @db.Text
  schema        Json?
  rowCount      Int?     @map("row_count")
  fileSize      BigInt?  @map("file_size")
  filePath      String?  @map("file_path") @db.Text
  checksum      String?  @db.VarChar(128)
  maskedColumns Json?    @map("masked_columns")
  maskingRules  Json?    @map("masking_rules")
  anonymizedColumns Json? @map("anonymized_columns")
  anonymizationRules Json? @map("anonymization_rules")
  dataJson      Json?    @map("data_json")
  changeDescription String? @map("change_description") @db.Text
  changedBy     String?  @map("changed_by") @db.VarChar(128)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, versionNumber])
  @@index([datasetId])
  @@index([version])
  @@map("dataset_versions")
}

model DatasetColumn {
  id            String   @id @default(uuid()) @db.Uuid
  datasetId     String   @map("dataset_id") @db.Uuid
  name          String   @db.VarChar(256)
  displayName   String?  @map("display_name") @db.VarChar(256)
  description   String?  @db.Text
  dataType      String   @map("data_type") @db.VarChar(32)
  ordinalPosition Int    @map("ordinal_position")
  isNullable    Boolean  @default(true) @map("is_nullable")
  isPrimaryKey  Boolean  @default(false) @map("is_primary_key")
  encrypted     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, name])
  @@index([datasetId])
  @@map("dataset_columns")
}

model Dashboard {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  createdById  String              @map("created_by_id") @db.Uuid
  name         String              @db.VarChar(512)
  slug         String              @db.VarChar(512)
  description  String?             @db.Text
  visibility   DashboardVisibility @default(PRIVATE)
  kpiIds       String[]            @map("kpi_ids")
  settings     Json?               @default("{}")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?           @map("deleted_at") @db.Timestamptz

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("dashboards")
}

model Report {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  createdById   String       @map("created_by_id") @db.Uuid
  name          String       @db.VarChar(512)
  slug          String       @db.VarChar(512)
  description   String?      @db.Text
  status        ReportStatus @default(DRAFT)
  kpiIds        String[]     @map("kpi_ids")
  language      Language     @default(EN)
  settings      Json?        @default("{}")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("reports")
}

model Kpi {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  createdById   String    @map("created_by_id") @db.Uuid
  datasetId     String?   @map("dataset_id") @db.Uuid
  name          String    @db.VarChar(256)
  slug          String    @db.VarChar(256)
  description   String?   @db.Text
  status        KpiStatus @default(ACTIVE)
  unit          String?   @db.VarChar(64)
  formula       String?   @db.Text
  query         String?   @db.Text
  currentValue  Float?    @map("current_value")
  previousValue Float?    @map("previous_value")
  targetValue   Float?    @map("target_value")
  minValue      Float?    @map("min_value")
  maxValue      Float?    @map("max_value")
  trend         KpiTrend  @default(UNKNOWN)
  changePercent    Float?    @map("change_percent")
  sensitivityLevel String?   @map("sensitivity_level") @db.VarChar(32)
  frequency        ScheduleFrequency @default(DAILY)
  lastCalculatedAt DateTime? @map("last_calculated_at") @db.Timestamptz
  settings      Json?     @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataset Dataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([createdById])
  @@index([datasetId])
  @@index([status])
  @@index([deletedAt])
  @@map("kpis")
}

model Version {
  id            String       @id @default(uuid()) @db.Uuid
  resourceType  String       @map("resource_type") @db.VarChar(64)
  resourceId    String       @map("resource_id") @db.Uuid
  versionNumber Int          @map("version_number")
  label         String?      @db.VarChar(128)
  description   String?      @db.Text
  snapshot      Json
  status        VersionStatus @default(DRAFT)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([resourceType, resourceId, versionNumber])
  @@index([resourceType, resourceId])
  @@index([status])
  @@map("versions")
}

model Policy {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String   @db.Text
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  conditions  Json     @db.JsonB
  effect      String   @db.VarChar(30)
  priority    Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, resource, action])
  @@index([enabled])
  @@map("policies")
}

model WorkflowDefinition {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  triggerResource String   @map("trigger_resource") @db.VarChar(100)
  triggerAction   String   @map("trigger_action") @db.VarChar(100)
  steps           Json     @db.JsonB
  status          String   @default("active") @db.VarChar(30)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, triggerResource])
  @@index([status])
  @@map("workflow_definitions")
}

// ============================================================================
// GOVERNANCE MODELS
// ============================================================================

model AccessPolicy {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  description  String?  @db.Text
  resourceType String   @map("resource_type") @db.VarChar(64)
  resourceId   String?  @map("resource_id") @db.VarChar(128)
  rules        String?  @db.Text
  priority     Int      @default(0)
  enabled      Boolean  @default(true)
  createdBy    String?  @map("created_by") @db.VarChar(128)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([resourceType, resourceId])
  @@index([enabled])
  @@map("access_policies")
}

model AccessRequest {
  id               String    @id @default(uuid()) @db.Uuid
  requesterId      String    @map("requester_id") @db.VarChar(128)
  requesterName    String?   @map("requester_name") @db.VarChar(255)
  resourceType     String    @map("resource_type") @db.VarChar(64)
  resourceId       String?   @map("resource_id") @db.VarChar(128)
  requestedActions String?   @map("requested_actions") @db.Text
  requestedFields  String?   @map("requested_fields") @db.Text
  justification    String?   @db.Text
  status           String    @default("pending") @db.VarChar(32)
  reviewedBy       String?   @map("reviewed_by") @db.VarChar(128)
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz
  reviewNote       String?   @map("review_note") @db.Text
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([requesterId])
  @@index([status])
  @@map("access_requests")
}

model PermissionDelegation {
  id              String    @id @default(uuid()) @db.Uuid
  delegatorId     String    @map("delegator_id") @db.VarChar(128)
  delegateeId     String    @map("delegatee_id") @db.VarChar(128)
  resourceType    String    @map("resource_type") @db.VarChar(64)
  resourceId      String?   @map("resource_id") @db.VarChar(128)
  delegatedActions String?  @map("delegated_actions") @db.Text
  delegatedFields String?   @map("delegated_fields") @db.Text
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  revocable       Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([delegatorId])
  @@index([delegateeId])
  @@index([resourceType, resourceId])
  @@map("permission_delegations")
}

model AccessLog {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  resourceType     String   @map("resource_type") @db.VarChar(64)
  resourceId       String?  @map("resource_id") @db.VarChar(128)
  action           String   @db.VarChar(64)
  allowed          Boolean
  matchedRules     String?  @map("matched_rules") @db.Text
  deniedReasons    String?  @map("denied_reasons") @db.Text
  evaluationTimeMs Float?   @map("evaluation_time_ms")
  evaluatedAt      DateTime @default(now()) @map("evaluated_at") @db.Timestamptz

  @@index([userId])
  @@index([resourceId])
  @@index([evaluatedAt])
  @@map("access_logs")
}

model PermissionSuggestion {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.VarChar(128)
  userId     String   @map("user_id") @db.Uuid
  action     String   @db.VarChar(128)
  permission String   @db.VarChar(128)
  resource   String   @db.VarChar(128)
  reason     String?  @db.Text
  confidence Float    @default(0)
  status     String   @default("pending_review") @db.VarChar(32)
  modelUsed  String?  @map("model_used") @db.VarChar(64)
  promptHash String?  @map("prompt_hash") @db.VarChar(128)
  appliedBy  String?   @map("applied_by") @db.VarChar(128)
  appliedAt  DateTime? @map("applied_at") @db.Timestamptz
  reviewedBy String?   @map("reviewed_by") @db.VarChar(128)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId, userId])
  @@index([status])
  @@map("permission_suggestions")
}

model RlsAudit {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.VarChar(128)
  resource   String   @db.VarChar(128)
  resourceId String?  @map("resource_id") @db.VarChar(128)
  action     String   @db.VarChar(64)
  allowed    Boolean
  reason     String?  @db.Text
  checksum   String?  @db.VarChar(128)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, tenantId])
  @@index([resource])
  @@index([createdAt])
  @@map("rls_audits")
}

model RlsPolicy {
  id           String    @id @default(uuid()) @db.Uuid
