  "non_executable_items": {
    "B_CONSTITUTIONAL": [
      {
        "id": "F-000001",
        "text": "**Unified Intelligent Document & Data Platform**"
      },
      {
        "id": "F-000002",
        "text": "هيكلة حسب المحركات والخدمات — شاملة لجميع المميزات والوظائف وحالات الاستخدام"
      },
      {
        "id": "F-000003",
        "text": "الإصدار: 2.0 | التصنيف: سري | الهيكلة: حسب المحركات"
      },
      {
        "id": "F-000004",
        "text": "منصة ويب موحدة وشاملة تمثل نظام تشغيل ذكي للمستندات والبيانات. تعتمد بالكامل على الذكاء الاصطناعي وتوفر وضعين دائمين: الوضع السهل بضغطة زر والوضع المت"
      },
      {
        "id": "F-000005",
        "text": "المنصة ليست مجرد نظام بيانات ولوحات مؤشرات وتقارير، بل هي نظام تشغيل ذكي شامل للمستندات يتضمن:"
      },
      {
        "id": "F-000006",
        "text": "- محرك بيانات وملفات شامل يقرأ جميع الأنواع بلا حدود"
      },
      {
        "id": "F-000007",
        "text": "- محرك Excel احترافي بقدرات معالجة فائقة"
      },
      {
        "id": "F-000008",
        "text": "- محرك لوحات مؤشرات تفاعلية بمستوى احترافي"
      },
      {
        "id": "F-000009",
        "text": "- محرك تقارير احترافية دورية"
      },
      {
        "id": "F-000010",
        "text": "- محرك عروض تقديمية وإنفوجرافيك يتجاوز مستوى Gamma"
      },
      {
        "id": "F-000011",
        "text": "- محرك مطابقة حرفية هندسية دقيقة واحد لواحد"
      },
      {
        "id": "F-000012",
        "text": "- محرك تعريب احترافي متقدم يتجاوز مجرد عكس الاتجاه"
      },
      {
        "id": "F-000013",
        "text": "- محرك تحويل شامل بين جميع الصيغ"
      },
      {
        "id": "F-000014",
        "text": "- محرك ذكاء اصطناعي واستجواب حر"
      },
      {
        "id": "F-000015",
        "text": "- نظام حوكمة وصلاحيات وعمل جماعي"
      },
      {
        "id": "F-000016",
        "text": "- وضعان دائمان في كل ميزة: سهل بضغطة زر ومتقدم للتحكم الكامل"
      },
      {
        "id": "F-000017",
        "text": "- سحب وإفلات شامل في كل عملية"
      },
      {
        "id": "F-000018",
        "text": "- ذكاء اصطناعي مفعل في كل مكان يساعد ولا يتحكم"
      },
      {
        "id": "F-000019",
        "text": "- لا إغلاق نهائي لأي مخرجات: كل شيء قابل للتعديل دائماً"
      },
      {
        "id": "F-000020",
        "text": "- لا حدود لحجم البيانات أو عدد الملفات أو الصفوف"
      },
      {
        "id": "F-000021",
        "text": "- تكامل كامل بين جميع المحركات"
      },
      {
        "id": "F-000022",
        "text": "- واجهة رسومية فاخرة وعصرية"
      },
      {
        "id": "F-000023",
        "text": "- قابلية توسع غير محدودة وبنية وحدوية"
      },
      {
        "id": "F-002557",
        "text": "هذا المحرك مصمم ليتجاوز مستوى Gamma وأدوات العروض المتقدمة الحديثة في جميع القدرات."
      },
      {
        "id": "F-003888",
        "text": "هذا المحرك يضمن إعادة بناء أي تصميم من صورة أو ملف بدقة رياضية كاملة واحد لواحد. لا يوجد تقريب ولا تحسين ولا تفسير. إما تطابق رياضي كامل أو رفض التنفي"
      },
      {
        "id": "F-004024",
        "text": "هذا المحرك يتجاوز مجرد عكس الاتجاه إلى تعريب احترافي لغوي وطباعي وبصري متكامل."
      },
      {
        "id": "F-004261",
        "text": "المنصة قادرة على تحويل أي صيغة إلى أي صيغة أخرى بدقة عالية:"
      }
    ],
    "C_USER_PERSONA": [
      {
        "id": "F-000024",
        "text": "- مدراء الإدارات والمدراء التنفيذيون"
