{
  "layers": [
    {
      "name": "Edge Layer",
      "name_ar": "طبقة الحافة",
      "components": [
        {
          "name": "CDN",
          "tech": "CloudFront / Cloudflare",
          "purpose": "توزيع المحتوى الثابت والتخزين المؤقت"
        },
        {
          "name": "WAF",
          "tech": "AWS WAF / Cloudflare WAF",
          "purpose": "جدار حماية تطبيقات الويب"
        },
        {
          "name": "DDoS Protection",
          "tech": "AWS Shield / Cloudflare",
          "purpose": "حماية من هجمات الحرمان من الخدمة"
        }
      ]
    },
    {
      "name": "Load Balancing Layer",
      "name_ar": "طبقة موازنة الأحمال",
      "components": [
        {
          "name": "Application Load Balancer",
          "tech": "AWS ALB / Nginx",
          "purpose": "توزيع الطلبات على الخدمات"
        },
        {
          "name": "API Gateway",
          "tech": "Kong / AWS API Gateway",
          "purpose": "إدارة وتوجيه طلبات API"
        },
        {
          "name": "Rate Limiter",
          "tech": "Redis-based",
          "purpose": "تحديد معدل الطلبات"
        }
      ]
    },
    {
      "name": "Application Layer",
      "name_ar": "طبقة التطبيقات",
      "components": [
        {
          "name": "Frontend SPA",
          "tech": "React / Next.js",
          "purpose": "واجهة المستخدم التفاعلية"
        },
        {
          "name": "BFF Service",
          "tech": "Node.js / NestJS",
          "purpose": "Backend for Frontend — تجميع البيانات للواجهة"
        },
        {
          "name": "Service Mesh",
          "tech": "Istio / Linkerd",
          "purpose": "إدارة الاتصالات بين الخدمات"
        }
      ]
    },
    {
      "name": "Microservices Layer",
      "name_ar": "طبقة الخدمات المصغرة",
      "components": [
        {
          "name": "rasid-data-service",
          "tech": "Python / FastAPI + Docker",
          "purpose": "استيعاب ومعالجة وتحليل جميع أنواع البيانات والملفات مع دعم OCR والتنظيف والتحويل والفهرسة"
        },
        {
          "name": "rasid-excel-service",
          "tech": "Python / FastAPI + Docker",
          "purpose": "معالجة ملفات Excel بقدرات احترافية شاملة المعادلات والجداول المحورية والتنسيق والتحليل"
        },
        {
          "name": "rasid-dashboard-service",
          "tech": "Python / FastAPI + Docker",
          "purpose": "إنشاء وإدارة لوحات المؤشرات التفاعلية مع الرسوم البيانية والفلاتر والتحديث الحي"
        },
        {
          "name": "rasid-reporting-service",
          "tech": "Python / FastAPI + Docker",
          "purpose": "توليد التقارير الاحترافية الدورية مع القوالب والجدولة والتصدير المتعدد"
        },
        {
          "name": "rasid-presentation-service",
          "tech": "Python / FastAPI + Docker",
          "purpose": "إنشاء العروض التقديمية الاحترافية مع الشرائح والتأثيرات والقوالب والتصدير"
        },
        {
          "name": "rasid-infographic-service",
          "tech": "Python / FastAPI + Docker",
          "purpose": "تصميم وتوليد الإنفوجرافيك الاحترافي مع القوالب والعناصر البصرية"
        },
        {
          "name": "rasid-replication-service",
          "tech": "Python / FastAPI + Docker",
          "purpose": "المطابقة الحرفية الهندسية الدقيقة واحد لواحد مع التحقق والمقارنة"
        },
        {
          "name": "rasid-localization-service",
          "tech": "Python / FastAPI + Docker",
          "purpose": "التعريب الاحترافي المتقدم شاملاً RTL والخطوط العربية والتنسيق الثقافي"
        },
        {
          "name": "rasid-ai-service",
          "tech": "Python / FastAPI + Docker",
          "purpose": "الذكاء الاصطناعي والاستجواب الحر والتحليل الذكي والتوصيات والفهم اللغوي"
        },
        {
          "name": "rasid-governance-service",
          "tech": "Python / FastAPI + Docker",
          "purpose": "الحوكمة والصلاحيات والعمل الجماعي والتدقيق والتكامل وإدارة المستخدمين"
        },
        {
          "name": "rasid-library-service",
          "tech": "Python / FastAPI + Docker",
          "purpose": "إدارة مكتبة الأصول والملفات والوسائط المشتركة"
        },
        {
          "name": "rasid-template-service",
          "tech": "Python / FastAPI + Docker",
          "purpose": "إدارة القوالب الجاهزة والمخصصة لجميع المحركات"
        },
        {
          "name": "rasid-conversion-service",
          "tech": "Python / FastAPI + Docker",
          "purpose": "التحويل الشامل بين جميع صيغ الملفات والبيانات"
        }
      ]
    },
    {
      "name": "Message Queue Layer",
      "name_ar": "طبقة قوائم الرسائل",
      "components": [
        {
          "name": "Event Bus",
          "tech": "Apache Kafka",
          "purpose": "ناقل الأحداث بين الخدمات"
        },
        {
          "name": "Task Queue",
          "tech": "Celery + Redis",
          "purpose": "قائمة المهام غير المتزامنة"
        },
        {
          "name": "Notification Queue",
          "tech": "RabbitMQ",
          "purpose": "قائمة الإشعارات"
        }
      ]
    },
    {
      "name": "Data Layer",
      "name_ar": "طبقة البيانات",
      "components": [
        {
          "name": "Primary Database",
          "tech": "PostgreSQL (Multi-tenant)",
          "purpose": "قاعدة البيانات الرئيسية"
        },
        {
          "name": "Document Store",
          "tech": "MongoDB",
          "purpose": "تخزين المستندات والـ JSON"
        },
        {
          "name": "Cache Layer",
          "tech": "Redis Cluster",
          "purpose": "التخزين المؤقت"
        },
        {
          "name": "Search Engine",
          "tech": "Elasticsearch",
          "purpose": "البحث النصي الكامل"
        },
        {
          "name": "Vector Store",
          "tech": "Pinecone / Milvus",
          "purpose": "تخزين التمثيلات المتجهية"
        },
        {
          "name": "Object Storage",
          "tech": "AWS S3 / MinIO",
          "purpose": "تخزين الملفات والأصول"
        },
        {
          "name": "Time-Series DB",
          "tech": "TimescaleDB",
          "purpose": "بيانات السلاسل الزمنية"
        }
      ]
    },
    {
      "name": "AI Infrastructure Layer",
      "name_ar": "طبقة بنية الذكاء الاصطناعي",
      "components": [
        {
          "name": "LLM Gateway",
          "tech": "LiteLLM / Custom",
          "purpose": "بوابة نماذج اللغة الكبيرة"
        },
        {
          "name": "Model Registry",
          "tech": "MLflow",
          "purpose": "سجل النماذج"
        },
        {
          "name": "GPU Cluster",
          "tech": "NVIDIA A100 / H100",
          "purpose": "معالجة GPU للنماذج"
        },
        {
          "name": "Embedding Service",
          "tech": "Custom + OpenAI",
          "purpose": "خدمة التمثيلات المتجهية"
        }
      ]
    },
    {
      "name": "Observability Layer",
      "name_ar": "طبقة المراقبة والرصد",
      "components": [
        {
          "name": "Metrics",
          "tech": "Prometheus + Grafana",
          "purpose": "مقاييس الأداء"
        },
        {
          "name": "Logging",
          "tech": "ELK Stack",
          "purpose": "تجميع وتحليل السجلات"
        },
        {
          "name": "Tracing",
          "tech": "Jaeger / OpenTelemetry",
          "purpose": "تتبع الطلبات"
        },
        {
          "name": "Alerting",
          "tech": "PagerDuty / Grafana Alerts",
          "purpose": "التنبيهات"
        }
      ]
    },
    {
      "name": "CI/CD Layer",
      "name_ar": "طبقة التكامل والنشر المستمر",
      "components": [
        {
          "name": "Source Control",
          "tech": "GitHub / GitLab",
          "purpose": "إدارة الكود المصدري"
        },
        {
          "name": "CI Pipeline",
          "tech": "GitHub Actions / GitLab CI",
          "purpose": "خط التكامل المستمر"
        },
        {
          "name": "Container Registry",
          "tech": "ECR / Harbor",
          "purpose": "سجل الحاويات"
        },
        {
          "name": "Orchestrator",
          "tech": "Kubernetes (EKS)",
          "purpose": "تنسيق الحاويات"
        },
        {
          "name": "IaC",
          "tech": "Terraform / Pulumi",
          "purpose": "البنية التحتية كرمز"
        }
      ]
    }
  ],
  "k8s_specs": [
    {
      "service": "rasid-data-service",
      "engine": "Data Engine",
      "namespace": "rasid-production",
      "deployment": {
        "replicas": 3,
        "strategy": "RollingUpdate",
        "maxSurge": 1,
        "maxUnavailable": 0
      },
      "container": {
        "image": "rasid-registry/rasid-data-service:latest",
        "port": 8001,
        "resources": {
          "requests": {
            "cpu": "500m",
            "memory": "1Gi"
          },
          "limits": {
            "cpu": "2000m",
            "memory": "4Gi"
          }
        },
        "healthCheck": {
          "path": "/health",
          "port": 8001,
          "initialDelay": 30,
          "period": 10
        }
      },
      "service_k8s": {
        "type": "ClusterIP",
        "port": 8001
      },
      "hpa": {
        "minReplicas": 3,
        "maxReplicas": 9,
        "targetCPU": 70,
        "targetMemory": 80
      },
      "features": 1259
