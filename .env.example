# ═══════════════════════════════════════════════
# RASID PLATFORM — Environment Variables
# ═══════════════════════════════════════════════

# Database
POSTGRES_USER=rasid
POSTGRES_PASSWORD=rasid_secret_2024
POSTGRES_DB=rasid_db
DATABASE_URL=postgresql://rasid:rasid_secret_2024@postgres:5432/rasid_db

# Redis
REDIS_URL=redis://redis:6379

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=rasid_minio
MINIO_SECRET_KEY=rasid_minio_secret
MINIO_BUCKET=rasid-files
MINIO_USE_SSL=false

# JWT Authentication
JWT_SECRET=rasid_jwt_secret_change_in_production_2024
JWT_REFRESH_SECRET=rasid_jwt_refresh_secret_change_in_production_2024
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@rasid.app
SMTP_PASS=your-smtp-password-here
SMTP_FROM=RASID Platform <noreply@rasid.app>

# Application
NODE_ENV=production
API_URL=http://localhost
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost

# Service Ports
DATA_SERVICE_PORT=8001
EXCEL_SERVICE_PORT=8002
DASHBOARD_SERVICE_PORT=8003
REPORTING_SERVICE_PORT=8004
PRESENTATION_SERVICE_PORT=8005
INFOGRAPHIC_SERVICE_PORT=8006
REPLICATION_SERVICE_PORT=8007
LOCALIZATION_SERVICE_PORT=8008
AI_SERVICE_PORT=8009
GOVERNANCE_SERVICE_PORT=8010
LIBRARY_SERVICE_PORT=8011
TEMPLATE_SERVICE_PORT=8012
CONVERSION_SERVICE_PORT=8013

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE_MB=500
UPLOAD_TEMP_DIR=/tmp/rasid-uploads
