generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Core Registry: Dataset Registry (3 tables) ─────────────────

model Dataset {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(500)
  description String?  @db.Text
  sourceType  DatasetSourceType @map("source_type")
  filePath    String?  @map("file_path") @db.VarChar(1000)
  format      String?  @db.VarChar(50)
  sizeBytes   BigInt?  @map("size_bytes")
  rowCount    BigInt?  @map("row_count")
  columnCount Int?     @map("column_count")
  schemaJson  Json?    @map("schema_json")
  status      DatasetStatus @default(active)
  engine      String?  @db.VarChar(100)
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  creator     User     @relation("DatasetCreator", fields: [createdBy], references: [id])
  columns     DatasetColumn[]
  versions    DatasetVersion[]
  workbooks   Workbook[]
  dashboardWidgets DashboardWidget[]
  tableName   String?  @map("table_name") @db.VarChar(500)
  metadata    Json?
  sourceConnection String? @map("source_connection") @db.Text
  qualityScore Float?  @map("quality_score")
  qualityDetails Json? @map("quality_details")
  tags        Json?
  category    String?  @db.VarChar(200)
  owner       String?  @db.VarChar(500)

  ingestionJobs IngestionJob[]
  dataQualityChecks DataQualityCheck[]
  dataRows    DataRow[]
  readingSessions ReadingSession[]
  tableViews  TableView[]
  visualProcessings VisualProcessing[]
  mixedFileEntries MixedFileEntry[]
  dataProfiles DataProfile[]
  qualityScores QualityScore[]
  anomalyDetections AnomalyDetection[]
  lineageNodes LineageNode[]
  lineageEdges LineageEdge[]
  dataDictionaryEntries DataDictionaryEntry[]
  columnLineages ColumnLineage[]
  datasetAccessLogs DatasetAccessLog[]
  datasetUsageStats DatasetUsageStats?
  pipelines   Pipeline[]

  @@index([tenantId])
  @@index([sourceType])
  @@index([format])
  @@index([status])
  @@index([engine])
  @@index([createdAt])
  @@map("datasets")
}

model DatasetColumn {
  id              String   @id @default(uuid()) @db.Uuid
  datasetId       String   @map("dataset_id") @db.Uuid
  name            String   @db.VarChar(500)
  originalName    String?  @map("original_name") @db.VarChar(500)
  dataType        String?  @map("data_type") @db.VarChar(100)
  inferredType    String?  @map("inferred_type") @db.VarChar(100)
  position        Int?
  displayOrder    Int?     @default(0) @map("display_order")
  nullable        Boolean?
  isVisible       Boolean  @default(true) @map("is_visible")
  isRequired      Boolean  @default(false) @map("is_required")
  isPrimaryKey    Boolean  @default(false) @map("is_primary_key")
  defaultValue    String?  @map("default_value") @db.VarChar(1000)
  format          String?  @db.VarChar(200)
  minValue        String?  @map("min_value") @db.VarChar(500)
  maxValue        String?  @map("max_value") @db.VarChar(500)
  transformations Json?
  statsJson       Json?    @map("stats_json")
  metadata        Json?

  dataset         Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@index([displayOrder])
  @@map("dataset_columns")
}

model DatasetVersion {
  id            String   @id @default(uuid()) @db.Uuid
  datasetId     String   @map("dataset_id") @db.Uuid
  version       Int
  changeType    ChangeType? @map("change_type")
  changeSummary String?  @map("change_summary") @db.Text
  snapshotPath  String?  @map("snapshot_path") @db.VarChar(1000)
  createdAt     DateTime @default(now()) @map("created_at")

  dataset       Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
  @@map("dataset_versions")
}

// ─── Core Registry: Metadata Registry (2 tables) ────────────────

model Metadata {
  id         String   @id @default(uuid()) @db.Uuid
  entityType EntityType @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  key        String   @db.VarChar(500)
  value      String?  @db.Text
  dataType   String?  @map("data_type") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([entityType])
  @@index([entityId])
  @@index([tenantId])
  @@index([key])
  @@map("metadata")
}

model Tag {
  id         String     @id @default(uuid()) @db.Uuid
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id") @db.Uuid
  tag        String     @db.VarChar(200)
  createdBy  String     @map("created_by") @db.Uuid

  creator    User       @relation(fields: [createdBy], references: [id])

  @@index([entityType])
  @@index([entityId])
  @@index([tag])
  @@map("tags")
}

// ─── Core Registry: Template Registry (1 table) ─────────────────

model Template {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  name          String           @db.VarChar(500)
  category      TemplateCategory
  engine        String?          @db.VarChar(100)
  templateJson  Json?            @map("template_json")
  thumbnailPath String?          @map("thumbnail_path") @db.VarChar(1000)
  isSystem      Boolean          @default(false) @map("is_system")
  usageCount    Int              @default(0) @map("usage_count")
  createdBy     String           @map("created_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")

  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  creator       User             @relation("TemplateCreator", fields: [createdBy], references: [id])
  reports       Report[]
  presentations Presentation[]
  infographics  Infographic[]

  @@index([tenantId])
  @@index([category])
  @@index([engine])
  @@index([isSystem])
  @@map("templates")
}

// ─── Core Registry: User Registry (4 tables) ────────────────────

model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(500)
  plan         TenantPlan @default(free)
  settingsJson Json?    @map("settings_json")
  createdAt    DateTime @default(now()) @map("created_at")

  users        User[]
  datasets     Dataset[]
  metadata     Metadata[]
  templates    Template[]
  dashboards   Dashboard[]
  reports      Report[]
  presentations Presentation[]
  infographics  Infographic[]
  replicationJobs ReplicationJob[]
  localizationJobs LocalizationJob[]
  aiSessions    AiSession[]
  auditLogs     AuditLog[]
  versions      Version[]
  roles         Role[]
  libraryAssets LibraryAsset[]
  conversionJobs ConversionJob[]
  workbooks     Workbook[]
  ingestionJobs IngestionJob[]
  translationMemories TranslationMemory[]
  glossaries          Glossary[]
  knowledgeBases      KnowledgeBase[]
  promptTemplates     PromptTemplate[]
  notifications       Notification[]
  workflows           Workflow[]
  assetFolders        AssetFolder[]

  connectorConnections ConnectorConnection[]
  dataSources          DataSource[]
  uploadSessions       UploadSession[]
  knowledgeGraphNodes  KnowledgeGraphNode[]

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  email        String     @unique @db.VarChar(500)
  name         String     @db.VarChar(500)
  role         UserRole   @default(viewer)
  passwordHash String     @map("password_hash") @db.VarChar(500)
  status       UserStatus @default(active)
  lastLogin    DateTime?  @map("last_login")
  createdAt    DateTime   @default(now()) @map("created_at")

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  userRoles    UserRole2[]
  datasets     Dataset[]  @relation("DatasetCreator")
  templates    Template[] @relation("TemplateCreator")
  tags         Tag[]
  dashboards   Dashboard[] @relation("DashboardCreator")
  reports      Report[]   @relation("ReportCreator")
  presentations Presentation[] @relation("PresentationCreator")
  infographics  Infographic[] @relation("InfographicCreator")
  aiSessions    AiSession[]
  auditLogs     AuditLog[]
  versions      Version[]  @relation("VersionCreator")
  libraryAssets LibraryAsset[] @relation("LibraryAssetCreator")
  workbooks     Workbook[] @relation("WorkbookCreator")

  @@index([tenantId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Role {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String   @db.VarChar(200)
  permissionsJson Json?    @map("permissions_json")

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  userRoles       UserRole2[]
  permissions     Permission[]

  @@index([tenantId])
  @@map("roles")
}

model UserRole2 {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ─── Core Registry: Version Registry (1 table) ──────────────────

model Version {
  id            String     @id @default(uuid()) @db.Uuid
  entityType    EntityType @map("entity_type")
  entityId      String     @map("entity_id") @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  versionNumber Int        @map("version_number")
  snapshotJson  Json?      @map("snapshot_json")
  changeLog     String?    @map("change_log") @db.Text
  createdBy     String     @map("created_by") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")

  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  creator       User       @relation("VersionCreator", fields: [createdBy], references: [id])

  @@index([entityType])
  @@index([entityId])
  @@index([tenantId])
  @@map("versions")
}

// ─── Core Registry: Feature Registry (1 table) ──────────────────

model Feature {
  id            String        @id @db.VarChar(10)
  hash          String        @unique @db.VarChar(64)
  text          String        @db.Text
  engine        String?       @db.VarChar(100)
  moduleId      String?       @map("module_id") @db.VarChar(10)
  service       String?       @db.VarChar(100)
  sourceSection String?       @map("source_section") @db.VarChar(500)
  status        FeatureStatus @default(locked)

  @@index([engine])
  @@index([moduleId])
  @@index([service])
  @@map("features")
}

// ─── Data Engine: Organization & Storage ────────────────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(500)
  slug      String   @unique @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  storageQuotas StorageQuota[]

  @@map("organizations")
}

model StorageQuota {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  totalBytes         BigInt   @map("total_bytes")
  usedBytes          BigInt   @default(0) @map("used_bytes")
  maxDatasets        Int      @map("max_datasets")
  maxRowsPerDataset  Int?     @map("max_rows_per_dataset")
  tier               String   @default("standard") @db.VarChar(50)
  isUnlimited        Boolean  @default(false) @map("is_unlimited")
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([tier])
  @@map("storage_quotas")
}

// ─── Data Engine: File Classification ───────────────────────────

model FileClassification {
  id                String   @id @default(uuid()) @db.Uuid
  fileName          String   @map("file_name") @db.VarChar(1000)
  fileType          String   @map("file_type") @db.VarChar(100)
  fileSize          BigInt   @map("file_size")
  mimeType          String?  @map("mime_type") @db.VarChar(200)
  classifiedType    String   @map("classified_type") @db.VarChar(200)
  confidence        Float
  aiModel           String?  @map("ai_model") @db.VarChar(200)
  suggestedSchema   Json?    @map("suggested_schema")
  detectedEncoding  String?  @map("detected_encoding") @db.VarChar(50)
  detectedDelimiter String?  @map("detected_delimiter") @db.VarChar(10)
  previewData       Json?    @map("preview_data")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([fileType])
  @@index([classifiedType])
  @@map("file_classifications")
}

// ─── Data Engine: Reading Sessions ──────────────────────────────

model ReadingSession {
  id              String   @id @default(uuid()) @db.Uuid
  datasetId       String   @map("dataset_id") @db.Uuid
  sessionType     String   @map("session_type") @db.VarChar(100)
  pageSize        Int      @default(50) @map("page_size")
  currentPage     Int      @default(1) @map("current_page")
  cursorPosition  Json?    @map("cursor_position")
  filters         Json?
  sortConfig      Json?    @map("sort_config")
  highlightRules  Json?    @map("highlight_rules")
  bookmarks       Json?
  isActive        Boolean  @default(true) @map("is_active")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  dataset         Dataset  @relation(fields: [datasetId], references: [id])

  @@index([datasetId])
  @@index([isActive])
  @@map("reading_sessions")
}

// ─── Data Engine: Table Views ───────────────────────────────────

model TableView {
  id              String   @id @default(uuid()) @db.Uuid
  datasetId       String   @map("dataset_id") @db.Uuid
  name            String   @db.VarChar(500)
  description     String?  @db.Text
  viewType        String   @default("table") @map("view_type") @db.VarChar(50)
  columnConfig    Json?    @map("column_config")
  filterConfig    Json?    @map("filter_config")
  sortConfig      Json?    @map("sort_config")
  groupConfig     Json?    @map("group_config")
  aggregateConfig Json?    @map("aggregate_config")
  pivotConfig     Json?    @map("pivot_config")
  isDefault       Boolean  @default(false) @map("is_default")
  isShared        Boolean  @default(false) @map("is_shared")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  dataset         Dataset  @relation(fields: [datasetId], references: [id])

  @@index([datasetId])
  @@index([viewType])
  @@map("table_views")
}

// ─── Data Engine: Visual Processing ─────────────────────────────

model VisualProcessing {
  id              String    @id @default(uuid()) @db.Uuid
  datasetId       String    @map("dataset_id") @db.Uuid
  processingType  String    @map("processing_type") @db.VarChar(100)
  status          String    @default("pending") @db.VarChar(50)
  inputConfig     Json?     @map("input_config")
  outputConfig    Json?     @map("output_config")
  chartType       String?   @map("chart_type") @db.VarChar(100)
  visualConfig    Json?     @map("visual_config")
  resultData      Json?     @map("result_data")
  thumbnailUrl    String?   @map("thumbnail_url") @db.VarChar(2000)
  errorMessage    String?   @map("error_message") @db.Text
  metadata        Json?
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  dataset         Dataset   @relation(fields: [datasetId], references: [id])

  @@index([datasetId])
  @@index([status])
  @@index([processingType])
  @@map("visual_processings")
}

// ─── Data Engine: Mixed File Entries ────────────────────────────

model MixedFileEntry {
  id            String   @id @default(uuid()) @db.Uuid
  datasetId     String   @map("dataset_id") @db.Uuid
  fileName      String   @map("file_name") @db.VarChar(1000)
  fileType      String   @map("file_type") @db.VarChar(100)
  fileSize      BigInt   @map("file_size")
  filePath      String   @map("file_path") @db.VarChar(2000)
  sheetName     String?  @map("sheet_name") @db.VarChar(500)
  sheetIndex    Int?     @map("sheet_index")
  extractedData Json?    @map("extracted_data")
  status        String   @default("pending") @db.VarChar(50)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  dataset       Dataset  @relation(fields: [datasetId], references: [id])

  @@index([datasetId])
  @@index([fileType])
  @@index([status])
  @@map("mixed_file_entries")
}

// ─── Engine: Data Engine (2 tables) ─────────────────────────────

model IngestionJob {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  datasetId String          @map("dataset_id") @db.Uuid
  sourceUrl String?         @map("source_url") @db.VarChar(2000)
  status    JobStatus       @default(pending)
  progress  Int?            @default(0)
  errorLog  String?         @map("error_log") @db.Text
  createdAt DateTime        @default(now()) @map("created_at")

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  dataset   Dataset         @relation(fields: [datasetId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("ingestion_jobs")
}

model DataQualityCheck {
  id          String      @id @default(uuid()) @db.Uuid
  datasetId   String      @map("dataset_id") @db.Uuid
  checkType   CheckType   @map("check_type")
  result      CheckResult
  detailsJson Json?       @map("details_json")
  createdAt   DateTime    @default(now()) @map("created_at")

  dataset     Dataset     @relation(fields: [datasetId], references: [id])

  @@index([datasetId])
  @@map("data_quality_checks")
}

// ─── Engine: Excel Engine (1 table) ─────────────────────────────

model Workbook {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  datasetId    String?  @map("dataset_id") @db.Uuid
  name         String   @db.VarChar(500)
  sheetsJson   Json?    @map("sheets_json")
  formulasJson Json?    @map("formulas_json")
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  dataset      Dataset? @relation(fields: [datasetId], references: [id])
  creator      User     @relation("WorkbookCreator", fields: [createdBy], references: [id])

  @@index([tenantId])
  @@map("workbooks")
}

// ─── Engine: Dashboard Engine (2 tables) ────────────────────────

model Dashboard {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(500)
  layoutJson  Json?    @map("layout_json")
  filtersJson Json?    @map("filters_json")
  isPublished Boolean  @default(false) @map("is_published")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  creator     User     @relation("DashboardCreator", fields: [createdBy], references: [id])
  widgets     DashboardWidget[]
  filters     DashboardFilter[]

  @@index([tenantId])
  @@index([isPublished])
  @@map("dashboards")
}

model DashboardWidget {
  id           String  @id @default(uuid()) @db.Uuid
  dashboardId  String  @map("dashboard_id") @db.Uuid
  widgetType   WidgetType @map("widget_type")
  configJson   Json?   @map("config_json")
  datasetId    String? @map("dataset_id") @db.Uuid
  positionJson Json?   @map("position_json")

  dashboard    Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  dataset      Dataset?  @relation(fields: [datasetId], references: [id])

  @@index([dashboardId])
  @@map("dashboard_widgets")
}

// ─── Engine: Reporting Engine (2 tables) ────────────────────────

model Report {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String   @db.VarChar(500)
  templateId    String?  @map("template_id") @db.Uuid
  configJson    Json?    @map("config_json")
  scheduleJson  Json?    @map("schedule_json")
  dataSourceId  String?  @map("data_source_id") @db.Uuid
  lastGenerated DateTime? @map("last_generated")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  template      Template? @relation(fields: [templateId], references: [id])
  creator       User     @relation("ReportCreator", fields: [createdBy], references: [id])
  outputs       ReportOutput[]
  scheduledReports ScheduledReport[]

  @@index([tenantId])
  @@map("reports")
}

model ReportOutput {
  id        String       @id @default(uuid()) @db.Uuid
  reportId  String       @map("report_id") @db.Uuid
  format    OutputFormat
  filePath  String?      @map("file_path") @db.VarChar(1000)
  sizeBytes BigInt?      @map("size_bytes")
  createdAt DateTime     @default(now()) @map("created_at")

  report    Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_outputs")
}

// ─── Engine: Presentation Engine (1 table) ──────────────────────

model Presentation {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String   @db.VarChar(500)
  templateId String?  @map("template_id") @db.Uuid
  slidesJson Json?    @map("slides_json")
  themeJson  Json?    @map("theme_json")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  template   Template? @relation(fields: [templateId], references: [id])
  creator    User     @relation("PresentationCreator", fields: [createdBy], references: [id])

  @@index([tenantId])
  @@map("presentations")
}

// ─── Engine: Infographic Engine (1 table) ───────────────────────

model Infographic {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String   @db.VarChar(500)
  templateId   String?  @map("template_id") @db.Uuid
  elementsJson Json?    @map("elements_json")
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  template     Template? @relation(fields: [templateId], references: [id])
  creator      User     @relation("InfographicCreator", fields: [createdBy], references: [id])

  @@index([tenantId])
  @@map("infographics")
}

// ─── Engine: Replication Engine (1 table) ───────────────────────

model ReplicationJob {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  sourceId    String?   @map("source_id") @db.Uuid
  targetId    String?   @map("target_id") @db.Uuid
  matchScore  Decimal?  @map("match_score") @db.Decimal(5, 4)
  status      JobStatus @default(pending)
  detailsJson Json?     @map("details_json")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@map("replication_jobs")
}

