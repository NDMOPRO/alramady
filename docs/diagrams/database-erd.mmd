        json channels
        json recipients
    }

    ReportDefinition ||--o{ Report : "generates"
    ReportDefinition ||--o{ ReportSchedule : "scheduled"
    ReportDefinition ||--o{ DistributionConfig : "distributes"

    %% ══════════════════════════════════════
    %% E05: PRESENTATION SERVICE
    %% ══════════════════════════════════════

    Presentation {
        string id PK
        string tenantId FK
        string title
        string status
        string themeId
    }

    Slide {
        string id PK
        string presentationId FK
