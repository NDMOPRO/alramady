%% Rasid Platform - Database Entity Relationship Diagram
%% Organized by service domain

erDiagram

    %% ══════════════════════════════════════
    %% CORE ENTITIES (Root / Governance)
    %% ══════════════════════════════════════

    Tenant {
        string id PK
        string name
        string slug
        string plan
        string status
        datetime createdAt
    }

    User {
        string id PK
        string tenantId FK
        string email
        string name
        string passwordHash
        string status
        string role
        datetime createdAt
    }

    Role {
        string id PK
        string tenantId FK
        string name
        string description
    }

    UserRole {
        string id PK
        string userId FK
        string roleId FK
    }

    Permission {
        string id PK
        string roleId FK
        string action
        string resource
        string resourceType
    }

    AuditLog {
        string id PK
        string tenantId FK
        string userId FK
        string action
        string resource
        json details
        datetime createdAt
    }

    Tenant ||--o{ User : "has"
    Tenant ||--o{ Role : "defines"
    User ||--o{ UserRole : "assigned"
    Role ||--o{ UserRole : "assigned"
    Role ||--o{ Permission : "grants"
    Tenant ||--o{ AuditLog : "logs"
    User ||--o{ AuditLog : "performs"

    %% ══════════════════════════════════════
    %% E01: DATA SERVICE
    %% ══════════════════════════════════════

    Dataset {
        string id PK
        string tenantId FK
        string name
        string sourceType
        string status
        int rowCount
        json metadata
        datetime createdAt
    }

    DatasetColumn {
        string id PK
        string datasetId FK
        string name
        string dataType
        int position
        boolean nullable
    }

    DataRow {
        string id PK
        string datasetId FK
        json data
        int rowIndex
    }

    DatasetVersion {
        string id PK
        string datasetId FK
        int versionNumber
        string changeType
        datetime createdAt
    }

    IngestionJob {
        string id PK
        string tenantId FK
        string sourceType
        string status
        string filePath
        json result
    }

    DataQualityCheck {
        string id PK
        string datasetId FK
        string checkType
        string result
        float score
    }

    KnowledgeGraphNode {
        string id PK
        string tenantId FK
        string label
        string nodeType
        json properties
    }

    KnowledgeGraphEdge {
        string id PK
        string sourceNodeId FK
        string targetNodeId FK
        string relationship
    }

    Pipeline {
        string id PK
        string tenantId FK
        string name
        json steps
        string status
    }

    SyncSchedule {
        string id PK
        string sourceId UK
        string cronExpression
        boolean enabled
    }

    ConnectorConnection {
        string id PK
        string tenantId FK
        string connectorType
        json config
        datetime lastUsedAt
    }

    Dataset ||--o{ DatasetColumn : "has"
    Dataset ||--o{ DataRow : "contains"
    Dataset ||--o{ DatasetVersion : "versioned"
    Dataset ||--o{ DataQualityCheck : "validated"
    Tenant ||--o{ Dataset : "owns"
    Tenant ||--o{ IngestionJob : "runs"
    Tenant ||--o{ ConnectorConnection : "configures"
    KnowledgeGraphNode ||--o{ KnowledgeGraphEdge : "source"
    KnowledgeGraphNode ||--o{ KnowledgeGraphEdge : "target"
    Tenant ||--o{ Pipeline : "defines"

    %% ══════════════════════════════════════
    %% E02: EXCEL SERVICE
    %% ══════════════════════════════════════

    Workbook {
        string id PK
        string tenantId FK
        string name
        string status
        json sheetsJson
        json formulasJson
    }

    ExcelWorkbook {
        string id PK
        string tenantId FK
        string title
        string fileUrl
    }

    Sheet {
        string id PK
        string workbookId FK
        string name
        int index
    }

    Cell {
        string id PK
        string sheetId FK
        string address
        string value
        string formula
        json formatting
    }

    Chart {
        string id PK
        string sheetId FK
        string chartType
        json config
    }

    Macro {
        string id PK
        string workbookId FK
        string name
        string code
    }

    Workbook ||--o{ Sheet : "contains"
    Sheet ||--o{ Cell : "has"
    Sheet ||--o{ Chart : "displays"
    Workbook ||--o{ Macro : "runs"

    %% ══════════════════════════════════════
    %% E03: DASHBOARD SERVICE
    %% ══════════════════════════════════════

    Dashboard {
