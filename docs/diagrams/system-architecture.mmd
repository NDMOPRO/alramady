        Browser["Web Browser"]
        MobileApp["Mobile App"]
        ExternalAPI["External API Consumers"]
    end

    subgraph Gateway["API Gateway (Nginx :80)"]
        NGINX["Nginx Reverse Proxy<br/>Rate Limiting: 100r/s<br/>Max Upload: 500MB<br/>Gzip Compression"]
    end

    subgraph Frontend["Frontend (:3000)"]
        NextJS["Next.js 14+<br/>TypeScript | Tailwind | shadcn/ui<br/>RTL-First | Arabic UI"]
    end

    subgraph CoreEngines["Core Engines"]
        E01["E01: Data & Files<br/>:8001"]
