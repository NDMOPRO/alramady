  fileSize     Int?     @map("file_size")
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, externalId], name: "tenantId_externalId")
  @@index([tenantId])
  @@map("synced_files")
}

// ============================================================================
// EXTERNAL INTEGRATION
// ============================================================================

model ExternalIntegration {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  provider     String    @db.VarChar(64)
  accessToken  String?   @map("access_token") @db.Text
  refreshToken String?   @map("refresh_token") @db.Text
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, provider], name: "userId_provider")
  @@index([userId])
  @@map("external_integrations")
}

// ============================================================================
// UNDO/REDO
// ============================================================================

model ActionLog {
  id            String   @id @default(uuid()) @db.Uuid
  actionId      String   @map("action_id") @db.VarChar(128)
  userId        String   @map("user_id") @db.Uuid
  actionType    String   @map("action_type") @db.VarChar(64)
  entityType    String   @map("entity_type") @db.VarChar(64)
  entityId      String   @map("entity_id") @db.VarChar(128)
  previousState String?  @map("previous_state") @db.Text
  newState      String?  @map("new_state") @db.Text
  metadata      String?  @db.Text
  performedAt   DateTime @default(now()) @map("performed_at") @db.Timestamptz

  @@index([userId])
  @@index([actionId])
  @@index([performedAt])
  @@map("action_logs")
}

// ============================================================================
// PII REDACTION
// ============================================================================

model PiiScanLog {
  id                  String   @id @default(uuid()) @db.Uuid
  datasetId           String   @map("dataset_id") @db.VarChar(128)
  mode                String   @db.VarChar(32)
  totalRecordsScanned Int      @map("total_records_scanned")
  totalDetections     Int      @map("total_detections")
  detectionsByType    String?  @map("detections_by_type") @db.Text
  scannedBy           String?  @map("scanned_by") @db.VarChar(128)
  performedAt         DateTime @default(now()) @map("performed_at") @db.Timestamptz

  @@index([datasetId])
  @@map("pii_scan_logs")
}
